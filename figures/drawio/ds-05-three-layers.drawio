        <mxCell id="n2" value="One SPARQL query joins three layers of triples" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontColor=#1F2A36;fontStyle=1;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="-58.0" y="13.8" width="900.0" height="34.0" as="geometry"/></mxCell>
        <mxCell id="n3" value="explicit  +  OWL/RDFS-inferred  +  custom-rule-derived" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#5C6B7A;fontStyle=2;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="-108.0" y="49.6" width="1000.0" height="24.0" as="geometry"/></mxCell>
        <mxCell id="n4" value="&lt;b&gt;Explicit triples&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#5C6B7A'&gt;&lt;i&gt;asserted in plant.ttl, product.ttl, runtime.ttl&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#C7E2B4;strokeColor=#1F2A36;fontColor=#1F2A36;fontSize=12;strokeWidth=0.9;verticalAlign=top;align=center;spacingLeft=4;spacingRight=4;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="22.4" y="123.2" width="347.2" height="100.8" as="geometry"/></mxCell>
        <mxCell id="n5" value="ex:WP3            prod:requiresProcess   ex:DistributeProcess .&lt;br&gt;ex:TransferUnit1  core:provides          ex:Type_skTransfer_adp .&lt;br&gt;ex:DistStation1   core:hasState          runtime:Available ." style="text;html=1;align=left;verticalAlign=top;fontSize=8.5;fontColor=#1F2A36;fontStyle=0;fontFamily=Courier New;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="39.2" y="154.0" width="317.2" height="70.0" as="geometry"/></mxCell>
        <mxCell id="n6" value="&lt;b&gt;OWL2-RL-inferred triples&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#5C6B7A'&gt;&lt;i&gt;materialised at load-time by the GraphDB ruleset&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FCE7A2;strokeColor=#1F2A36;fontColor=#1F2A36;fontSize=12;strokeWidth=0.9;verticalAlign=top;align=center;spacingLeft=4;spacingRight=4;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="22.4" y="240.8" width="347.2" height="100.8" as="geometry"/></mxCell>
        <mxCell id="n7" value="ex:Type_skTransfer_adp  a  core:Skill .&lt;br&gt;ex:FeederUnit1          core:connectedTo  ex:TransferUnit1 .&lt;br&gt;ex:TransferUnit1        a  res:Machine ,  core:Resource ." style="text;html=1;align=left;verticalAlign=top;fontSize=8.5;fontColor=#1F2A36;fontStyle=0;fontFamily=Courier New;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="39.2" y="271.6" width="317.2" height="70.0" as="geometry"/></mxCell>
        <mxCell id="n8" value="&lt;b&gt;Custom-rule-derived triples&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#5C6B7A'&gt;&lt;i&gt;materialised by capability + manufacturing CONSTRUCT rules&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF1B8;strokeColor=#1F2A36;fontColor=#1F2A36;fontSize=12;strokeWidth=0.9;verticalAlign=top;align=center;spacingLeft=4;spacingRight=4;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="22.4" y="358.4" width="347.2" height="100.8" as="geometry"/></mxCell>
        <mxCell id="n9" value="ex:TransferUnit1  core:canPerform     cap:PickPlaceCapability .&lt;br&gt;ex:TransferArm1   core:canPerform     cap:TransportCapability .&lt;br&gt;ex:DistStation1   core:canManufacture ex:WP3 ." style="text;html=1;align=left;verticalAlign=top;fontSize=8.5;fontColor=#1F2A36;fontStyle=0;fontFamily=Courier New;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="39.2" y="389.2" width="317.2" height="70.0" as="geometry"/></mxCell>
        <mxCell id="n10" value="&lt;b&gt;SPARQL  SELECT  query (against the materialised store)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F7F9FB;strokeColor=#1F2A36;fontColor=#1F2A36;fontSize=11;strokeWidth=0.9;verticalAlign=top;align=center;spacingLeft=4;spacingRight=4;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="414.4" y="123.2" width="347.2" height="196.0" as="geometry"/></mxCell>
        <mxCell id="n11" value="SELECT ?plant ?product ?state WHERE {&lt;br&gt;  ?plant   a core:Plant ;                # explicit&lt;br&gt;           core:canManufacture ?product; # rule-derived&lt;br&gt;           core:hasState ?state .        # explicit (runtime)&lt;br&gt;  ?product prod:requiresProcess ?proc .&lt;br&gt;  ?product a/rdfs:subClassOf*&lt;br&gt;           core:Product .                # OWL-inferred&lt;br&gt;}" style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontColor=#1F2A36;fontStyle=0;fontFamily=Courier New;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="425.6" y="173.6" width="350.0" height="160.0" as="geometry"/></mxCell>
