# MAESTRO SPARQL Query 02 — Skill implementations
#
# For each Skill, list every ControlComponent that implements it
# (across all execution adapters: ROS, IEC 61131, IEC 61499, OPC UA, AAS).

PREFIX core:  <https://w3id.org/maestro/core#>
PREFIX skill: <https://w3id.org/maestro/skill#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?skill ?skillLabel ?component ?componentType
WHERE {
    ?skill a/rdfs:subClassOf* core:Skill .
    ?component ?implements ?skill ;
               a ?componentType .
    ?implements rdfs:subPropertyOf* core:implements .
    OPTIONAL { ?skill rdfs:label ?skillLabel }
}
ORDER BY ?skill ?component
