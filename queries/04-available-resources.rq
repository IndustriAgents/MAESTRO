# MAESTRO SPARQL Query 04 — Available resources (runtime)
#
# Return all Resources currently in the runtime:Available state.
# This is the canonical query for an orchestrator picking idle machines.

PREFIX core:    <https://w3id.org/maestro/core#>
PREFIX runtime: <https://w3id.org/maestro/runtime#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?resource ?label
WHERE {
    ?resource a/rdfs:subClassOf* core:Resource ;
              core:hasState runtime:Available .
    OPTIONAL { ?resource rdfs:label ?label }
}
