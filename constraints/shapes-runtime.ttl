@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix core:    <https://w3id.org/maestro/core#> .
@prefix skill:   <https://w3id.org/maestro/skill#> .
@prefix runtime: <https://w3id.org/maestro/runtime#> .
@prefix shape:   <https://w3id.org/maestro/shapes#> .

#################################################################
# SHACL SHAPES — RUNTIME LAYER
#
# Runtime shapes target subjects that carry runtime triples
# (sh:targetSubjectsOf core:hasState). Apply ONLY when validating
# a runtime snapshot. Design-time-only loads do not have any
# core:hasState assertions and therefore are not targeted.
# See decisions/0002-runtime-graph-separation.md.
#################################################################

shape:HasStateShape a sh:NodeShape ;
    sh:targetSubjectsOf core:hasState ;
    rdfs:label "Anything that asserts core:hasState must have exactly one current State."@en ;
    sh:property [
        sh:path core:hasState ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class core:State ;
        sh:severity sh:Warning ;
        sh:message "An entity holds at most one current state; composite states should be modelled with sub-states." ;
    ] .

shape:StateTransitionShape a sh:NodeShape ;
    sh:targetClass runtime:StateTransition ;
    rdfs:label "Every state transition needs a timestamp and target state."@en ;
    sh:property [
        sh:path runtime:timestamp ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:message "StateTransition must have a runtime:timestamp." ;
    ] ;
    sh:property [
        sh:path runtime:enteredState ;
        sh:minCount 1 ;
        sh:class core:State ;
        sh:message "StateTransition must declare runtime:enteredState." ;
    ] .

shape:SnapshotShape a sh:NodeShape ;
    sh:targetClass runtime:Snapshot ;
    rdfs:label "Every runtime snapshot must declare when it was taken."@en ;
    sh:property [
        sh:path runtime:snapshotTaken ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:message "runtime:Snapshot must declare runtime:snapshotTaken." ;
    ] .

#################################################################
# SKILL EXECUTION RECORD (new 0.4.0)
#################################################################

shape:SkillExecutionShape a sh:NodeShape ;
    sh:targetClass runtime:SkillExecution ;
    rdfs:label "Every SkillExecution must record the Skill it ran and its time."@en ;
    sh:property [
        sh:path runtime:executes ;
        sh:minCount 1 ;
        sh:class core:Skill ;
        sh:message "A runtime:SkillExecution must declare runtime:executes (the Skill that ran)." ;
    ] ;
    sh:property [
        sh:path runtime:hasTime ;
        sh:minCount 1 ;
        sh:class runtime:TimeInterval ;
        sh:message "A runtime:SkillExecution must declare runtime:hasTime (a runtime:TimeInterval)." ;
    ] .
