@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix core:  <https://w3id.org/maestro/core#> .
@prefix skill: <https://w3id.org/maestro/skill#> .
@prefix shape: <https://w3id.org/maestro/shapes#> .

#################################################################
# SHACL SHAPES — SKILL LAYER
#################################################################

shape:CompositeSkillShape a sh:NodeShape ;
    sh:targetClass skill:CompositeSkill ;
    rdfs:label "Composite skills must require at least one component skill."@en ;
    sh:property [
        sh:path skill:composedOfSkill ;
        sh:minCount 1 ;
        sh:message "A CompositeSkill must use skill:composedOfSkill for at least one constituent Skill." ;
    ] .

shape:SkillImplementationShape a sh:NodeShape ;
    sh:targetClass core:Skill ;
    rdfs:label "A Skill should be implemented by at least one ControlComponent (warning)."@en ;
    sh:property [
        sh:path [ sh:inversePath core:implements ] ;
        sh:minCount 1 ;
        sh:message "Skill has no implementing ControlComponent — it cannot be executed." ;
        sh:severity sh:Warning ;
    ] .

#################################################################
# SKILL ORCHESTRATION (new 0.4.0)
#################################################################

shape:ParameterDefShape a sh:NodeShape ;
    sh:targetClass skill:ParameterDef ;
    rdfs:label "Every ParameterDef must declare a data type."@en ;
    sh:property [
        sh:path skill:paramType ;
        sh:minCount 1 ;
        sh:message "A skill:ParameterDef must declare skill:paramType (an XSD datatype IRI)." ;
    ] .

shape:SubSkillLinkShape a sh:NodeShape ;
    sh:targetClass skill:SubSkillLink ;
    rdfs:label "Every SubSkillLink must reference a constituent Skill."@en ;
    sh:property [
        sh:path skill:linksTo ;
        sh:minCount 1 ;
        sh:class core:Skill ;
        sh:message "A skill:SubSkillLink must reference a core:Skill via skill:linksTo." ;
    ] .
