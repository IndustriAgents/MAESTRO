@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix core:    <https://w3id.org/maestro/core#> .
@prefix runtime: <https://w3id.org/maestro/runtime#> .
@prefix ex:      <https://w3id.org/maestro/examples/drilling-station#> .

#################################################################
# EXAMPLE — DRILLING STATION (RUNTIME SNAPSHOT)
#
# Load into a NAMED GRAPH separate from the design-time plant.ttl.
# See decisions/0002-runtime-graph-separation.md.
#################################################################

<https://w3id.org/maestro/examples/drilling-station/runtime> a owl:Ontology , runtime:Snapshot ;
    owl:versionIRI <https://w3id.org/maestro/examples/drilling-station/runtime/0.5.0> ;
    rdfs:label "MAESTRO Example: Drilling Station — Runtime Snapshot"@en ;
    owl:imports <https://w3id.org/maestro/examples/drilling-station> ;
    owl:versionInfo "0.5.0" ;
    runtime:snapshotTaken "2026-05-25T08:00:00Z"^^xsd:dateTime .

ex:DrillingStation1 core:hasState runtime:Available .
ex:DrillSpindle1    core:hasState runtime:Available .
ex:FeedAxis1        core:hasState runtime:Available .
