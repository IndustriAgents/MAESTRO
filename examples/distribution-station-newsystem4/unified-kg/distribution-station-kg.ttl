#################################################################
# UNIFIED KNOWLEDGE GRAPH — Festo Distributing Station (newsystem4)
#
# Self-contained T-Box + A-Box in ONE file (no owl:imports).
#   - T-BOX : the MAESTRO modules this station uses (core, resource,
#             motion, sensor, unit, skill, capability, process, product,
#             iec61499, opcua, runtime) + the station's local schema.
#   - A-BOX : the station instances (plant topology, sensors, datapoints,
#             skills, IEC 61499 FB layer, device/app, OPC UA) + the runtime
#             availability snapshot.
#
# Generated by merging the source modules with the example's plant.ttl,
# product.ttl and runtime.ttl; owl:imports were stripped for standalone use.
#
# GraphDB: create the repository with the OWL2-RL ruleset, import this single
# file, then run rules/capability-inference.rq and rules/manufacturing-ability.rq
# as SPARQL INSERTs to materialise core:canPerform / core:canManufacture.
#################################################################

#================================================================
# T-BOX  (schema: MAESTRO used-modules subset + local extensions)
#================================================================

@prefix cap: <https://w3id.org/maestro/capability#> .
@prefix core: <https://w3id.org/maestro/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://w3id.org/maestro/examples/distribution-station-newsystem4#> .
@prefix iec61499: <https://w3id.org/maestro/iec61499#> .
@prefix motion: <https://w3id.org/maestro/motion#> .
@prefix opcua: <https://w3id.org/maestro/opcua#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix proc: <https://w3id.org/maestro/process#> .
@prefix prod: <https://w3id.org/maestro/product#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix res: <https://w3id.org/maestro/resource#> .
@prefix runtime: <https://w3id.org/maestro/runtime#> .
@prefix sensor: <https://w3id.org/maestro/sensor#> .
@prefix skill: <https://w3id.org/maestro/skill#> .
@prefix skill-lib: <https://w3id.org/maestro/skill-lib#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix unit: <https://w3id.org/maestro/unit#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/maestro/capability> a owl:Ontology ;
    rdfs:label "MAESTRO Capability Ontology"@en ;
    rdfs:comment "Reusable manufacturing capability specifications. Capabilities are modeled as individuals of core:Capability so applications, rules, and SPARQL queries can traverse them directly."@en ;
    owl:versionIRI <https://w3id.org/maestro/capability/0.3.0> ;
    owl:versionInfo "0.3.0" .

cap:AssemblyCapability a skos:Concept,
        core:Capability ;
    rdfs:label "AssemblyCapability"@en ;
    rdfs:comment "Ability to combine parts into an assembly."@en ;
    skos:inScheme cap:CapabilityScheme ;
    skos:prefLabel "Assembly capability"@en .

cap:InspectionCapability a skos:Concept,
        core:Capability ;
    rdfs:label "InspectionCapability"@en ;
    skos:inScheme cap:CapabilityScheme ;
    skos:prefLabel "Inspection capability"@en .

cap:MachiningCapability a skos:Concept,
        core:Capability ;
    rdfs:label "MachiningCapability"@en ;
    skos:inScheme cap:CapabilityScheme ;
    skos:prefLabel "Machining capability"@en .

cap:PackagingCapability a skos:Concept,
        core:Capability ;
    rdfs:label "PackagingCapability"@en ;
    skos:inScheme cap:CapabilityScheme ;
    skos:prefLabel "Packaging capability"@en .

cap:PickPlaceCapability a skos:Concept,
        core:Capability ;
    rdfs:label "PickPlaceCapability"@en ;
    rdfs:comment "Pick a part at location A and place it at location B."@en ;
    skos:broader cap:HandlingCapability ;
    skos:inScheme cap:CapabilityScheme ;
    skos:prefLabel "Pick-and-place capability"@en ;
    cap:realizedBySkill skill-lib:Transfer .

cap:TestingCapability a skos:Concept,
        core:Capability ;
    rdfs:label "TestingCapability"@en ;
    skos:inScheme cap:CapabilityScheme ;
    skos:prefLabel "Testing capability"@en .

cap:TransportCapability a skos:Concept,
        core:Capability ;
    rdfs:label "TransportCapability"@en ;
    rdfs:comment "Ability to transport material between locations."@en ;
    skos:inScheme cap:CapabilityScheme ;
    skos:prefLabel "Transport capability"@en ;
    cap:realizedBySkill skill-lib:MoveJoint,
        skill-lib:MoveLinear .

cap:WeldingCapability a skos:Concept,
        core:Capability ;
    rdfs:label "WeldingCapability"@en ;
    skos:inScheme cap:CapabilityScheme ;
    skos:prefLabel "Welding capability"@en .

cap:realizedBySkill a owl:ObjectProperty ;
    rdfs:label "realizedBySkill"@en ;
    rdfs:comment "A Capability specification is realized by a reusable Skill specification."@en ;
    rdfs:domain core:Capability ;
    rdfs:range core:Skill ;
    rdfs:subPropertyOf core:realizedBySkill .

<https://w3id.org/maestro/core> a owl:Ontology ;
    rdfs:label "MAESTRO Core Ontology"@en ;
    dcterms:creator "Melwin Xavier" ;
    dcterms:license <https://opensource.org/licenses/MIT> ;
    dcterms:title "MAESTRO Core Ontology" ;
    rdfs:comment "Root abstractions of the MAESTRO modular manufacturing ontology stack. Every other module imports from here. 0.4.0 adds the additive core:constrains property reifying Constraint→target links (HHM-Core Priority 3)."@en ;
    owl:versionIRI <https://w3id.org/maestro/core/0.4.0> ;
    owl:versionInfo "0.4.0" .

core:canManufacture a owl:ObjectProperty ;
    rdfs:label "canManufacture"@en ;
    rdfs:comment "Inferred relation: a Plant can manufacture a Product. Materialised by rules/manufacturing-ability.rq."@en ;
    rdfs:domain core:Plant ;
    rdfs:range core:Product .

core:canPerform a owl:ObjectProperty ;
    rdfs:label "canPerform"@en ;
    rdfs:comment "Inferred relation: a Resource is capable of performing a Capability. Materialised by rules/capability-inference.rq."@en ;
    rdfs:domain core:Resource ;
    rdfs:range core:Capability .

core:communicatesThrough a owl:ObjectProperty ;
    rdfs:label "communicatesThrough"@en ;
    rdfs:comment "A ControlComponent communicates with a Resource through a communication channel. Range is com:Channel (kept open here to avoid pulling communication.ttl into core)."@en ;
    rdfs:domain core:ControlComponent .

core:constrains a owl:ObjectProperty ;
    rdfs:label "constrains"@en ;
    rdfs:comment "A Constraint reifies a restriction on a target — a Skill, recipe:PlanStep, res:Module or com:Endpoint. Range left open (union of targets) to keep OWL2-RL clean. New in 0.4.0 (HHM-Core Constraint→target edges)."@en ;
    rdfs:domain core:Constraint .

core:deployedOn a owl:ObjectProperty ;
    rdfs:label "deployedOn"@en ;
    rdfs:comment "A logical ControlComponent is deployed on a physical controller or compute Resource."@en ;
    rdfs:domain core:ControlComponent ;
    rdfs:range core:Resource .

core:description a owl:DatatypeProperty ;
    rdfs:label "description"@en ;
    rdfs:domain core:Entity ;
    rdfs:range xsd:string .

core:executes a owl:ObjectProperty ;
    rdfs:label "executes"@en ;
    rdfs:comment "A ControlComponent executes a Process or Skill at runtime. Range is core:Skill or core:Process — left open via union (not asserted to keep OWL2-RL clean)."@en ;
    rdfs:domain core:ControlComponent .

core:hasPlantCapability a owl:ObjectProperty ;
    rdfs:label "hasPlantCapability"@en ;
    rdfs:comment "Plant-level capability. Use this instead of core:canPerform on Plant individuals (canPerform is Resource-scoped)."@en ;
    rdfs:domain core:Plant ;
    rdfs:range core:Capability .

core:hasState a owl:ObjectProperty ;
    rdfs:label "hasState"@en ;
    rdfs:comment "Runtime operational State of an Entity. Use only inside a runtime named graph — see decisions/0002-runtime-graph-separation.md."@en ;
    rdfs:domain core:Entity ;
    rdfs:range core:State .

core:identifier a owl:DatatypeProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty ;
    rdfs:label "identifier"@en ;
    rdfs:comment "Globally unique identifier (e.g. AAS shortId, OPC UA NodeId). Functional (each entity has at most one) and inverse-functional (each identifier names at most one entity)."@en ;
    rdfs:domain core:Entity ;
    rdfs:range xsd:string .

core:provides a owl:ObjectProperty ;
    rdfs:label "provides"@en ;
    rdfs:comment "A Resource provides a Skill (offers it for use)."@en ;
    rdfs:domain core:Resource ;
    rdfs:range core:Skill ;
    owl:inverseOf core:providedBy .

core:version a owl:DatatypeProperty ;
    rdfs:label "version"@en ;
    rdfs:domain core:Entity ;
    rdfs:range xsd:string .

<https://w3id.org/maestro/examples/distribution-station-newsystem4> a owl:Ontology ;
    rdfs:label "MAESTRO Example: Festo Distributing Station (newsystem4) — Plant"@en ;
    rdfs:comment "Festo MPS Distributing Station. A feeder unit ejects the bottom workpiece from a vertical FIFO magazine with a pneumatic cylinder/pusher; a transfer unit (semi-rotary motor + arm carrying a vacuum suction cup) grips the workpiece at the magazine, rotates 180°, and releases it at the downstream station. Physical/sensor/datapoint layer aligned to the stakeholder topology figure."@en ;
    owl:versionIRI <https://w3id.org/maestro/examples/distribution-station-newsystem4/0.2.0> ;
    owl:versionInfo "0.2.0" .

ex:ControlConsole a owl:Class ;
    rdfs:label "ControlConsole"@en ;
    rdfs:comment "Operator HMI panel (Bedienpult): START/STOP/RESET illuminated buttons, AUTO/MAN key switch, EMERGENCY-STOP, and indicator lamps."@en ;
    rdfs:subClassOf res:Machine .

ex:FeederUnit a owl:Class ;
    rdfs:label "FeederUnit"@en ;
    rdfs:comment "Festo MPS feeder / stack-magazine unit: ejects the bottom workpiece from the vertical FIFO magazine onto the pickup position."@en ;
    rdfs:subClassOf res:Machine .

ex:LimitSwitch a owl:Class ;
    rdfs:label "LimitSwitch"@en ;
    rdfs:comment "Mechanical micro limit switch (Festo S-3-E) actuated by a trip cam on the rotary-drive shaft to sense an end position."@en ;
    rdfs:subClassOf sensor:Sensor .

ex:Magazine a owl:Class ;
    rdfs:label "Magazine"@en ;
    rdfs:comment "Vertical gravity-fed FIFO magazine barrel (Magazinrohr) holding up to 8 workpieces, open side up."@en ;
    rdfs:subClassOf res:Machine .

ex:MagneticProximitySensor a owl:Class ;
    rdfs:label "MagneticProximitySensor"@en ;
    rdfs:comment "Magneto-inductive proximity switch (Festo SME-8) that detects the permanent magnet on a cylinder piston at an end position."@en ;
    rdfs:subClassOf sensor:Sensor .

ex:PermitAdapterFB a owl:Class ;
    rdfs:label "PermitAdapterFB"@en ;
    rdfs:comment "A helper FB realising the Permit handshake (REQ/CNF + OK/LET) used to sequence neighbouring skills; True_Adp variants always grant permission."@en ;
    rdfs:subClassOf iec61499:CompositeFB .

ex:PneumaticCylinder a owl:Class ;
    rdfs:label "PneumaticCylinder"@en ;
    rdfs:comment "Double-acting pneumatic linear actuator."@en ;
    rdfs:subClassOf res:Actuator .

ex:ProtocolAdapterFB a owl:Class ;
    rdfs:label "ProtocolAdapterFB"@en ;
    rdfs:comment "A composite FB that converts one IEC 61499 adapter protocol into another (e.g. Magazine→Magasine, SwivelArm→Transfer)."@en ;
    rdfs:subClassOf iec61499:CompositeFB .

ex:Pusher a owl:Class ;
    rdfs:label "Pusher"@en ;
    rdfs:comment "Slider attached to the feeder cylinder rod that ejects a workpiece from the magazine."@en ;
    rdfs:subClassOf res:Tool .

ex:RotaryDrive a owl:Class ;
    rdfs:label "RotaryDrive"@en ;
    rdfs:comment "Double-acting pneumatic semi-rotary drive (Schwenkantrieb) with an adjustable 0–180° swivel range set by mechanical end stops."@en ;
    rdfs:subClassOf res:Actuator .

ex:SuctionCup a owl:Class ;
    rdfs:label "SuctionCup"@en ;
    rdfs:comment "Vacuum suction cup (Sauger) end-effector that grips the workpiece."@en ;
    rdfs:subClassOf res:Tool .

ex:ThroughBeamSensor a owl:Class ;
    rdfs:label "ThroughBeamSensor"@en ;
    rdfs:comment "Fibre-optic through-beam light barrier (Festo SOEG-L + SOEZ-SE) detecting whether the magazine barrel is filled."@en ;
    rdfs:subClassOf sensor:Sensor .

ex:TransferUnit a owl:Class ;
    rdfs:label "TransferUnit"@en ;
    rdfs:comment "Festo MPS transfer / changer unit: a semi-rotary motor swings an arm carrying a vacuum end-effector that transfers a workpiece from the magazine to the downstream station."@en ;
    rdfs:subClassOf res:Machine .

ex:VacuumFilter a owl:Class ;
    rdfs:label "VacuumFilter"@en ;
    rdfs:comment "In-line filter protecting the vacuum generator from contamination."@en ;
    rdfs:subClassOf res:Tool .

ex:VacuumGenerator a owl:Class ;
    rdfs:label "VacuumGenerator"@en ;
    rdfs:comment "Venturi vacuum generator creating suction from compressed air for the suction cup."@en ;
    rdfs:subClassOf res:Actuator .

ex:VacuumSwitch a owl:Class ;
    rdfs:label "VacuumSwitch"@en ;
    rdfs:comment "Vacuum pressure switch (Festo VPEV) that confirms a workpiece is securely held once the vacuum threshold is reached."@en ;
    rdfs:subClassOf sensor:Sensor .

ex:VacuumValve a owl:Class ;
    rdfs:label "VacuumValve"@en ;
    rdfs:comment "3/2-way solenoid valve switching the vacuum generator on/off."@en ;
    rdfs:subClassOf res:Actuator .

ex:bridges a owl:ObjectProperty ;
    rdfs:label "bridges"@en ;
    rdfs:comment "A protocol-adapter FB bridges the output adapter of one FB to the input adapter of another."@en ;
    rdfs:domain iec61499:FunctionBlock ;
    rdfs:range iec61499:FunctionBlock ;
    rdfs:subPropertyOf core:connectedTo .

ex:commandsActuator a owl:ObjectProperty ;
    rdfs:label "commandsActuator"@en ;
    rdfs:comment "An output I/O datapoint that, when set, drives the referenced actuator."@en ;
    rdfs:domain ex:IOSignal ;
    rdfs:range res:Actuator .

ex:controlsIO a owl:ObjectProperty ;
    rdfs:label "controlsIO"@en ;
    rdfs:comment "Skill manages / drives this I/O datapoint."@en ;
    rdfs:domain core:Skill ;
    rdfs:range ex:IOSignal ;
    rdfs:subPropertyOf skill:hasPostcondition .

ex:createsSignal a owl:ObjectProperty ;
    rdfs:label "createsSignal"@en ;
    rdfs:comment "A sensor produces this I/O datapoint."@en ;
    rdfs:domain core:Resource ;
    rdfs:range ex:IOSignal .

ex:drivenBy a owl:ObjectProperty ;
    rdfs:label "drivenBy"@en ;
    rdfs:comment "A passive mechanical element (e.g. the feeder pusher, the transfer arm) is moved by an Actuator."@en ;
    rdfs:domain core:Resource ;
    rdfs:range res:Actuator ;
    rdfs:subPropertyOf core:dependsOn .

ex:feeds a owl:ObjectProperty ;
    rdfs:label "feeds"@en ;
    rdfs:comment "Material-flow link: the source resource delivers workpieces to the target resource."@en ;
    rdfs:domain core:Resource ;
    rdfs:range core:Resource ;
    rdfs:subPropertyOf core:connectedTo .

ex:hasDuration a owl:ObjectProperty ;
    rdfs:label "hasDuration"@en ;
    rdfs:domain motion:Motion ;
    rdfs:range unit:Quantity .

ex:hasStrokeMeters a owl:DatatypeProperty ;
    rdfs:label "hasStrokeMeters"@en ;
    rdfs:comment "Linear stroke length of a LinearMotion, in metres."@en ;
    rdfs:domain motion:LinearMotion ;
    rdfs:range xsd:float .

ex:hasSubProcess a owl:ObjectProperty ;
    rdfs:label "hasSubProcess"@en ;
    rdfs:comment "A composite process decomposes into ordered sub-processes."@en ;
    rdfs:domain proc:ManufacturingProcess ;
    rdfs:range proc:ManufacturingProcess ;
    rdfs:subPropertyOf core:hasPart .

ex:hasSubSkill a owl:ObjectProperty ;
    rdfs:label "hasSubSkill"@en ;
    rdfs:comment "A composite skill TYPE (or registered instance) references its sub-skill."@en ;
    rdfs:domain core:Skill ;
    rdfs:range core:Skill ;
    rdfs:subPropertyOf skill:composedOfSkill .

ex:hostedOn a owl:ObjectProperty ;
    rdfs:label "hostedOn"@en ;
    rdfs:comment "An Application (or FB instance) is hosted on an IEC 61499 runtime resource / device."@en ;
    rdfs:subPropertyOf core:dependsOn .

ex:instanceOfFBT a owl:ObjectProperty ;
    rdfs:label "instanceOfFBT"@en ;
    rdfs:comment "An FB instance running in an application is an instance of an FB type (FBT)."@en ;
    rdfs:domain iec61499:FunctionBlock ;
    rdfs:range iec61499:FunctionBlock .

ex:ioDirection a owl:DatatypeProperty ;
    rdfs:label "ioDirection"@en ;
    rdfs:comment "IEC 61499 FB pin direction of the signal: 'input' (read by the FB) or 'output' (written by the FB)."@en ;
    rdfs:domain ex:IOSignal ;
    rdfs:range xsd:string .

ex:ofType a owl:ObjectProperty ;
    rdfs:label "ofType"@en ;
    rdfs:comment "A registered application skill instance (ABox) is an instance of a reusable skill TYPE."@en ;
    rdfs:domain core:Skill ;
    rdfs:range core:Skill .

ex:orderNumber a owl:DatatypeProperty ;
    rdfs:label "orderNumber"@en ;
    rdfs:comment "Festo order/part number of the physical component (from manual 648811)."@en ;
    rdfs:domain core:Resource ;
    rdfs:range xsd:string .

ex:permits a owl:ObjectProperty ;
    rdfs:label "permits"@en ;
    rdfs:comment "Permit handshake link (Perm_R → Perm_L): the source FB grants execution permission to the target FB, enforcing sequential ordering."@en ;
    rdfs:domain iec61499:FunctionBlock ;
    rdfs:range iec61499:FunctionBlock ;
    rdfs:subPropertyOf core:connectedTo .

ex:receivesIO a owl:ObjectProperty ;
    rdfs:label "receivesIO"@en ;
    rdfs:comment "Skill reads / depends on this I/O datapoint."@en ;
    rdfs:domain core:Skill ;
    rdfs:range ex:IOSignal ;
    rdfs:subPropertyOf skill:hasPrecondition .

<https://w3id.org/maestro/examples/distribution-station-newsystem4/product> a owl:Ontology ;
    rdfs:label "MAESTRO Example: Festo Distributing Station (newsystem4) — Product"@en ;
    owl:versionIRI <https://w3id.org/maestro/examples/distribution-station-newsystem4/product/0.1.0> ;
    owl:versionInfo "0.1.0" .

<https://w3id.org/maestro/examples/distribution-station-newsystem4/runtime> a owl:Ontology,
        runtime:Snapshot ;
    rdfs:label "MAESTRO Example: Festo Distributing Station (newsystem4) — Runtime Snapshot"@en ;
    owl:versionIRI <https://w3id.org/maestro/examples/distribution-station-newsystem4/runtime/0.1.0> ;
    owl:versionInfo "0.1.0" ;
    runtime:snapshotTaken "2026-06-29T08:00:00+00:00"^^xsd:dateTime .

<https://w3id.org/maestro/iec61499> a owl:Ontology ;
    rdfs:label "MAESTRO IEC 61499 Ontology"@en ;
    rdfs:comment "Event-driven distributed automation per IEC 61499. Function blocks are first-class control components."@en ;
    owl:versionIRI <https://w3id.org/maestro/iec61499/0.3.0> ;
    owl:versionInfo "0.3.0" .

iec61499:Application a owl:Class ;
    rdfs:label "Application"@en ;
    rdfs:subClassOf core:LogicalEntity .

iec61499:BasicFB a owl:Class ;
    rdfs:label "BasicFB"@en ;
    rdfs:comment "A basic function block defined by an ECC (Execution Control Chart)."@en ;
    rdfs:subClassOf iec61499:FunctionBlock .

iec61499:Connection a owl:Class ;
    rdfs:label "Connection"@en ;
    rdfs:subClassOf core:LogicalEntity .

iec61499:ServiceInterfaceFB a owl:Class ;
    rdfs:label "ServiceInterfaceFB"@en ;
    rdfs:subClassOf iec61499:FunctionBlock .

iec61499:consumesEvent a owl:ObjectProperty ;
    rdfs:label "consumesEvent"@en ;
    rdfs:domain iec61499:FunctionBlock ;
    rdfs:range iec61499:ExecutionEvent ;
    rdfs:subPropertyOf core:consumes .

iec61499:controlsResource a owl:ObjectProperty ;
    rdfs:label "controlsResource"@en ;
    rdfs:domain iec61499:FunctionBlock ;
    rdfs:range core:Resource ;
    rdfs:subPropertyOf core:controls .

iec61499:emitsEvent a owl:ObjectProperty ;
    rdfs:label "emitsEvent"@en ;
    rdfs:domain iec61499:FunctionBlock ;
    rdfs:range iec61499:ExecutionEvent ;
    rdfs:subPropertyOf core:emits .

iec61499:hostsRuntimeResource a owl:ObjectProperty ;
    rdfs:label "hostsRuntimeResource"@en ;
    rdfs:domain iec61499:Device ;
    rdfs:range iec61499:RuntimeResource ;
    rdfs:subPropertyOf core:hosts .

iec61499:implementsSkill a owl:ObjectProperty ;
    rdfs:label "implementsSkill"@en ;
    rdfs:domain iec61499:FunctionBlock ;
    rdfs:range core:Skill ;
    rdfs:subPropertyOf core:implements .

<https://w3id.org/maestro/motion> a owl:Ontology ;
    rdfs:label "MAESTRO Motion Ontology"@en ;
    rdfs:comment "Machine-independent motion semantics. Must remain independent of ROS, PLCs, and IEC 61499."@en ;
    owl:versionIRI <https://w3id.org/maestro/motion/0.3.0> ;
    owl:versionInfo "0.3.0" .

motion:CartesianMotion a owl:Class ;
    rdfs:label "CartesianMotion"@en ;
    rdfs:comment "Motion specified in Cartesian/task space."@en ;
    rdfs:subClassOf motion:Motion .

motion:ForceControlledMotion a owl:Class ;
    rdfs:label "ForceControlledMotion"@en ;
    rdfs:comment "Motion regulated by force/torque feedback."@en ;
    rdfs:subClassOf motion:Motion .

motion:JointMotion a owl:Class ;
    rdfs:label "JointMotion"@en ;
    rdfs:comment "Motion specified in joint space."@en ;
    rdfs:subClassOf motion:Motion .

motion:RotationalMotion a owl:Class ;
    rdfs:label "RotationalMotion"@en ;
    rdfs:subClassOf motion:Motion .

motion:SynchronizedMotion a owl:Class ;
    rdfs:label "SynchronizedMotion"@en ;
    rdfs:comment "Coordinated motion of multiple resources."@en ;
    rdfs:subClassOf motion:Motion .

motion:TrajectoryMotion a owl:Class ;
    rdfs:label "TrajectoryMotion"@en ;
    rdfs:comment "Motion defined by a parametric trajectory."@en ;
    rdfs:subClassOf motion:Motion .

motion:hasAcceleration a owl:DatatypeProperty ;
    rdfs:label "hasAcceleration"@en ;
    rdfs:range xsd:float .

motion:hasCoordinateFrame a owl:ObjectProperty ;
    rdfs:label "hasCoordinateFrame"@en ;
    rdfs:range motion:CoordinateFrame .

motion:hasPrecision a owl:DatatypeProperty ;
    rdfs:label "hasPrecision"@en ;
    rdfs:comment "Repeatability / positioning precision in mm."@en ;
    rdfs:range xsd:float .

motion:hasVelocity a owl:DatatypeProperty ;
    rdfs:label "hasVelocity"@en ;
    rdfs:comment "Linear velocity in m/s or angular velocity in rad/s, depending on motion subtype."@en ;
    rdfs:range xsd:float .

motion:numberOfAxes a owl:DatatypeProperty ;
    rdfs:label "numberOfAxes"@en ;
    rdfs:range xsd:integer .

motion:requiresAxis a owl:ObjectProperty ;
    rdfs:label "requiresAxis"@en ;
    rdfs:range motion:Axis .

<https://w3id.org/maestro/opcua> a owl:Ontology ;
    rdfs:label "MAESTRO OPC UA Ontology"@en ;
    rdfs:comment "OPC UA semantic interoperability layer. Skills are exposed to clients through OPC UA SkillInterfaces (inspired by CaSkMan). 0.4.0 declares opcua:OpcUaSkillInterface a subclass of the protocol-neutral skill:SkillInterface."@en ;
    owl:versionIRI <https://w3id.org/maestro/opcua/0.4.0> ;
    owl:versionInfo "0.4.0" .

opcua:OpcUaVariable a owl:Class ;
    rdfs:label "OpcUaVariable"@en ;
    rdfs:subClassOf opcua:OpcUaNode .

opcua:accessibleThrough a owl:ObjectProperty ;
    rdfs:label "accessibleThrough"@en ;
    rdfs:comment "A Skill is accessible through an OPC UA SkillInterface (inverse of opcua:exposes)."@en ;
    rdfs:domain core:Skill ;
    rdfs:range opcua:OpcUaSkillInterface ;
    owl:inverseOf opcua:exposes .

opcua:browseName a owl:DatatypeProperty ;
    rdfs:label "browseName"@en ;
    rdfs:domain opcua:OpcUaNode ;
    rdfs:range xsd:string .

opcua:hostsInterface a owl:ObjectProperty ;
    rdfs:label "hostsInterface"@en ;
    rdfs:domain opcua:OpcUaServer ;
    rdfs:range opcua:OpcUaSkillInterface .

opcua:implementsSkill a owl:ObjectProperty ;
    rdfs:label "implementsSkill"@en ;
    rdfs:domain opcua:OpcUaMethod ;
    rdfs:range core:Skill ;
    rdfs:subPropertyOf core:implements .

opcua:nodeId a owl:DatatypeProperty ;
    rdfs:label "nodeId"@en ;
    rdfs:comment "OPC UA NodeId (e.g. 'ns=2;s=Skill.Transfer.Start')."@en ;
    rdfs:domain opcua:OpcUaNode ;
    rdfs:range xsd:string .

<https://w3id.org/maestro/process> a owl:Ontology ;
    rdfs:label "MAESTRO Process Ontology"@en ;
    rdfs:comment "Manufacturing processes aligned with DIN 8580 (process taxonomy) and VDI 3682 (process description)."@en ;
    owl:versionIRI <https://w3id.org/maestro/process/0.3.0> ;
    owl:versionInfo "0.3.0" .

proc:AssemblyProcess a owl:Class ;
    rdfs:label "AssemblyProcess"@en ;
    rdfs:subClassOf proc:JoiningProcess .

proc:Coating a owl:Class ;
    rdfs:label "Coating"@en ;
    rdfs:comment "DIN 8580 Group 5."@en ;
    rdfs:subClassOf proc:ManufacturingProcess .

proc:Forming a owl:Class ;
    rdfs:label "Forming"@en ;
    rdfs:comment "DIN 8580 Group 2 — bending, drawing, forging."@en ;
    rdfs:subClassOf proc:ManufacturingProcess .

proc:InspectionProcess a owl:Class ;
    rdfs:label "InspectionProcess"@en ;
    rdfs:subClassOf proc:ManufacturingProcess .

proc:MachiningProcess a owl:Class ;
    rdfs:label "MachiningProcess"@en ;
    rdfs:subClassOf proc:Separating .

proc:MaterialPropertyChange a owl:Class ;
    rdfs:label "MaterialPropertyChange"@en ;
    rdfs:comment "DIN 8580 Group 6 — heat treatment."@en ;
    rdfs:subClassOf proc:ManufacturingProcess .

proc:PrimaryShaping a owl:Class ;
    rdfs:label "PrimaryShaping"@en ;
    rdfs:comment "DIN 8580 Group 1 — casting, sintering."@en ;
    rdfs:subClassOf proc:ManufacturingProcess .

proc:TransportProcess a owl:Class ;
    rdfs:label "TransportProcess"@en ;
    rdfs:subClassOf proc:HandlingProcess .

proc:parallelWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "parallelWith"@en ;
    rdfs:domain proc:ManufacturingProcess ;
    rdfs:range proc:ManufacturingProcess .

proc:precedes a owl:ObjectProperty ;
    rdfs:label "precedes"@en ;
    rdfs:domain proc:ManufacturingProcess ;
    rdfs:range proc:ManufacturingProcess ;
    owl:inverseOf proc:follows .

proc:producesState a owl:ObjectProperty ;
    rdfs:label "producesState"@en ;
    rdfs:domain proc:ManufacturingProcess ;
    rdfs:range core:State .

proc:requiresCapability a owl:ObjectProperty ;
    rdfs:label "requiresCapability"@en ;
    rdfs:domain proc:ManufacturingProcess ;
    rdfs:range core:Capability ;
    rdfs:subPropertyOf core:requiresCapability .

<https://w3id.org/maestro/product> a owl:Ontology ;
    rdfs:label "MAESTRO Product Ontology"@en ;
    rdfs:comment "Products, parts, assemblies, features, and tolerances. A Product declares the Processes required to manufacture it. 0.4.0 adds an explicit type/instance split, variants, requirements, multi-scheme identifiers and a structured BOM node — closing the HHM-Core product-identity gap (Priority 4)."@en ;
    owl:versionIRI <https://w3id.org/maestro/product/0.4.0> ;
    owl:versionInfo "0.4.0" .

prod:GTIN a owl:Class ;
    rdfs:label "GTIN"@en ;
    rdfs:subClassOf prod:Identifier .

prod:IRDI a owl:Class ;
    rdfs:label "IRDI"@en ;
    rdfs:comment "International Registration Data Identifier (e.g. ECLASS / IEC CDD)."@en ;
    rdfs:subClassOf prod:Identifier .

prod:IRI a owl:Class ;
    rdfs:label "IRI"@en ;
    rdfs:subClassOf prod:Identifier .

prod:Part a owl:Class ;
    rdfs:label "Part"@en ;
    rdfs:comment "An atomic manufactured item — not further decomposed in this model."@en ;
    rdfs:subClassOf core:Product .

prod:UUID a owl:Class ;
    rdfs:label "UUID"@en ;
    rdfs:subClassOf prod:Identifier .

prod:appliesTo a owl:ObjectProperty ;
    rdfs:label "appliesTo"@en ;
    rdfs:comment "A Requirement applies to a Feature."@en ;
    rdfs:domain prod:Requirement ;
    rdfs:range prod:Feature .

prod:hasBOMNode a owl:ObjectProperty ;
    rdfs:label "hasBOMNode"@en ;
    rdfs:comment "An Assembly is structured by BOM nodes."@en ;
    rdfs:domain prod:Assembly ;
    rdfs:range prod:BOMNode .

prod:hasFeature a owl:ObjectProperty ;
    rdfs:label "hasFeature"@en ;
    rdfs:domain core:Product ;
    rdfs:range prod:Feature .

prod:hasIdentifier a owl:ObjectProperty ;
    rdfs:label "hasIdentifier"@en ;
    rdfs:comment "A Product carries one or more scheme-qualified Identifiers."@en ;
    rdfs:domain core:Product ;
    rdfs:range prod:Identifier .

prod:hasTolerance a owl:ObjectProperty ;
    rdfs:label "hasTolerance"@en ;
    rdfs:domain prod:Feature ;
    rdfs:range prod:Tolerance .

prod:instanceOfType a owl:ObjectProperty ;
    rdfs:label "instanceOfType"@en ;
    rdfs:comment "Links a produced ProductInstance to the ProductType it realises."@en ;
    rdfs:domain prod:ProductInstance ;
    rdfs:range prod:ProductType .

prod:madeOf a owl:ObjectProperty ;
    rdfs:label "madeOf"@en ;
    rdfs:domain core:Product ;
    rdfs:range prod:Material .

prod:mass a owl:ObjectProperty ;
    rdfs:label "mass"@en ;
    rdfs:comment "Product mass as a unit-bearing quantity."@en ;
    rdfs:domain core:Product ;
    rdfs:range unit:Quantity .

prod:massKg a owl:DatatypeProperty ;
    rdfs:label "massKg"@en ;
    rdfs:comment "Deprecated unit-suffixed datatype property. Use prod:mass with unit:Quantity instead."@en ;
    rdfs:domain core:Product ;
    rdfs:range xsd:float ;
    owl:deprecated true .

prod:nodeFor a owl:ObjectProperty ;
    rdfs:label "nodeFor"@en ;
    rdfs:comment "The Product referenced by a BOM node."@en ;
    rdfs:domain prod:BOMNode ;
    rdfs:range core:Product .

prod:position a owl:DatatypeProperty ;
    rdfs:label "position"@en ;
    rdfs:comment "Position / location of the node in the assembly."@en ;
    rdfs:domain prod:BOMNode ;
    rdfs:range xsd:string .

prod:quantity a owl:DatatypeProperty ;
    rdfs:label "quantity"@en ;
    rdfs:comment "Quantity of the referenced Product in this BOM node."@en ;
    rdfs:domain prod:BOMNode ;
    rdfs:range xsd:decimal .

prod:refDesignator a owl:DatatypeProperty ;
    rdfs:label "refDesignator"@en ;
    rdfs:comment "Reference designator (e.g. 'R1', 'C3')."@en ;
    rdfs:domain prod:BOMNode ;
    rdfs:range xsd:string .

prod:requiresProcess a owl:ObjectProperty ;
    rdfs:label "requiresProcess"@en ;
    rdfs:comment "A Product requires a Manufacturing Process to be produced."@en ;
    rdfs:domain core:Product ;
    rdfs:range proc:ManufacturingProcess .

prod:scheme a owl:DatatypeProperty ;
    rdfs:label "scheme"@en ;
    rdfs:comment "Identifier scheme name, e.g. 'GTIN', 'UUID', 'IRDI', 'IRI'."@en ;
    rdfs:domain prod:Identifier ;
    rdfs:range xsd:string .

prod:value a owl:DatatypeProperty ;
    rdfs:label "value"@en ;
    rdfs:comment "The identifier value within its scheme."@en ;
    rdfs:domain prod:Identifier ;
    rdfs:range xsd:string .

prod:variantOf a owl:ObjectProperty ;
    rdfs:label "variantOf"@en ;
    rdfs:comment "A Variant is a configuration of a base ProductType."@en ;
    rdfs:domain prod:Variant ;
    rdfs:range prod:ProductType .

<https://w3id.org/maestro/resource> a owl:Ontology ;
    rdfs:label "MAESTRO Resource Ontology"@en ;
    rdfs:comment "Physical manufacturing assets. Resources DO NOT contain manufacturing semantics — they only provide skills, support motion, and expose interfaces. 0.4.0 adds res:Module, the reconfigurable plug-and-produce module that anchors AutomationML topology (HHM-Core Priority 6)."@en ;
    owl:versionIRI <https://w3id.org/maestro/resource/0.4.0> ;
    owl:versionInfo "0.4.0" .

res:AGV a owl:Class ;
    rdfs:label "AGV"@en ;
    rdfs:comment "Automated Guided Vehicle."@en ;
    rdfs:subClassOf res:Machine .

res:AssemblyStation a owl:Class ;
    rdfs:label "AssemblyStation"@en ;
    rdfs:comment "Workstation where assembly operations take place."@en ;
    rdfs:subClassOf res:Machine .

res:CNC a owl:Class ;
    rdfs:label "CNC"@en ;
    rdfs:comment "Computer Numerical Control machining centre."@en ;
    rdfs:subClassOf res:Machine .

res:Cobot a owl:Class ;
    rdfs:label "Cobot"@en ;
    rdfs:comment "A collaborative robot designed for safe human interaction."@en ;
    rdfs:subClassOf res:Robot .

res:Conveyor a owl:Class ;
    rdfs:label "Conveyor"@en ;
    rdfs:comment "Material handling conveyor."@en ;
    rdfs:subClassOf res:Machine .

res:Gripper a owl:Class ;
    rdfs:label "Gripper"@en ;
    rdfs:subClassOf res:Tool .

res:IndustrialPC a owl:Class ;
    rdfs:label "IndustrialPC"@en ;
    rdfs:comment "Industrial compute hardware that hosts logical ControlComponents."@en ;
    rdfs:subClassOf res:ControllerDevice .

res:LaserUnit a owl:Class ;
    rdfs:label "LaserUnit"@en ;
    rdfs:comment "Laser machining / marking / welding unit."@en ;
    rdfs:subClassOf res:Machine .

res:Module a owl:Class ;
    rdfs:label "Module"@en ;
    rdfs:comment "A reconfigurable, plug-and-produce production module (MTP-style). As an AutomationML InternalElement it anchors imported plant topology, ports and connections."@en ;
    rdfs:subClassOf <https://w3id.org/maestro/automationml#InternalElement>,
        core:Resource .

res:PLC a owl:Class ;
    rdfs:label "PLC"@en ;
    rdfs:comment "Programmable Logic Controller hardware. PLC programs and Function Blocks are logical ControlComponents deployed on this hardware."@en ;
    rdfs:subClassOf res:ControllerDevice .

res:ServoMotor a owl:Class ;
    rdfs:label "ServoMotor"@en ;
    rdfs:subClassOf res:Actuator .

res:ToolChanger a owl:Class ;
    rdfs:label "ToolChanger"@en ;
    rdfs:subClassOf res:Tool .

res:TransferArm a owl:Class ;
    rdfs:label "TransferArm"@en ;
    rdfs:comment "A robotic arm specialised for transfer / pick-and-place tasks."@en ;
    rdfs:subClassOf res:Robot .

res:VacuumUnit a owl:Class ;
    rdfs:label "VacuumUnit"@en ;
    rdfs:comment "Vacuum end-effector for pick operations."@en ;
    rdfs:subClassOf res:Tool .

res:manufacturer a owl:DatatypeProperty ;
    rdfs:label "manufacturer"@en ;
    rdfs:range xsd:string .

res:model a owl:DatatypeProperty ;
    rdfs:label "model"@en ;
    rdfs:range xsd:string .

res:payload a owl:ObjectProperty ;
    rdfs:label "payload"@en ;
    rdfs:comment "Maximum payload as an explicit quantity value."@en ;
    rdfs:domain res:Robot ;
    rdfs:range unit:Quantity .

res:payloadKg a owl:DatatypeProperty ;
    rdfs:label "payloadKg"@en ;
    rdfs:comment "Maximum payload of a robot or handling resource, in kilograms."@en ;
    rdfs:range xsd:float ;
    owl:deprecated true .

res:reach a owl:ObjectProperty ;
    rdfs:label "reach"@en ;
    rdfs:comment "Robot reach as an explicit quantity value."@en ;
    rdfs:domain res:Robot ;
    rdfs:range unit:Quantity .

res:reachMm a owl:DatatypeProperty ;
    rdfs:label "reachMm"@en ;
    rdfs:comment "Robot reach in millimetres."@en ;
    rdfs:range xsd:float ;
    owl:deprecated true .

res:serialNumber a owl:DatatypeProperty ;
    rdfs:label "serialNumber"@en ;
    rdfs:range xsd:string .

<https://w3id.org/maestro/runtime> a owl:Ontology ;
    rdfs:label "MAESTRO Runtime Ontology"@en ;
    rdfs:comment "Live operational state. PackML-aligned state values are modeled as canonical individuals of core:State. 0.4.0 adds a runtime:SkillExecution record and runtime:TimeInterval — the subject HHM-Core needs for execution provenance (Priority 5). PROV-O and SAREF4INMA bridges live in execution/prov.ttl and execution/trace.ttl."@en ;
    owl:versionIRI <https://w3id.org/maestro/runtime/0.4.0> ;
    owl:versionInfo "0.4.0" .

runtime:Aborted a skos:Concept,
        core:State ;
    rdfs:label "Aborted"@en ;
    skos:inScheme runtime:StateScheme ;
    skos:prefLabel "Aborted"@en .

runtime:Alarm a skos:Concept,
        core:State ;
    rdfs:label "Alarm"@en ;
    skos:inScheme runtime:StateScheme ;
    skos:prefLabel "Alarm"@en .

runtime:Available a skos:Concept,
        core:State ;
    rdfs:label "Available"@en ;
    rdfs:comment "Resource is ready to accept work."@en ;
    skos:inScheme runtime:StateScheme ;
    skos:prefLabel "Available"@en .

runtime:Executing a skos:Concept,
        core:State ;
    rdfs:label "Executing"@en ;
    rdfs:comment "PackML 'Execute' substate."@en ;
    skos:broader runtime:Busy ;
    skos:inScheme runtime:StateScheme ;
    skos:prefLabel "Executing"@en .

runtime:Fault a skos:Concept,
        core:State ;
    rdfs:label "Fault"@en ;
    rdfs:comment "Resource is in a faulted or error state."@en ;
    skos:inScheme runtime:StateScheme ;
    skos:prefLabel "Fault"@en .

runtime:HealthState a skos:Concept,
        core:State ;
    rdfs:label "HealthState"@en ;
    rdfs:comment "Diagnostic health indicator such as healthy, degraded, or failed."@en ;
    skos:inScheme runtime:StateScheme ;
    skos:prefLabel "Health state"@en .

runtime:Held a skos:Concept,
        core:State ;
    rdfs:label "Held"@en ;
    rdfs:comment "PackML 'Held' state: execution paused."@en ;
    skos:inScheme runtime:StateScheme ;
    skos:prefLabel "Held"@en .

runtime:Idle a skos:Concept,
        core:State ;
    rdfs:label "Idle"@en ;
    skos:inScheme runtime:StateScheme ;
    skos:prefLabel "Idle"@en .

runtime:endTime a owl:DatatypeProperty ;
    rdfs:label "endTime"@en ;
    rdfs:domain runtime:TimeInterval ;
    rdfs:range xsd:dateTime .

runtime:enteredState a owl:ObjectProperty ;
    rdfs:label "enteredState"@en ;
    rdfs:domain runtime:StateTransition ;
    rdfs:range core:State .

runtime:executedOn a owl:ObjectProperty ;
    rdfs:label "executedOn"@en ;
    rdfs:comment "The Resource the Skill ran on."@en ;
    rdfs:domain runtime:SkillExecution ;
    rdfs:range core:Resource .

runtime:executes a owl:ObjectProperty ;
    rdfs:label "executes"@en ;
    rdfs:comment "The Skill that this execution ran."@en ;
    rdfs:domain runtime:SkillExecution ;
    rdfs:range core:Skill .

runtime:fromState a owl:ObjectProperty ;
    rdfs:label "fromState"@en ;
    rdfs:domain runtime:StateTransition ;
    rdfs:range core:State .

runtime:hasInput a owl:ObjectProperty ;
    rdfs:label "hasInput"@en ;
    rdfs:comment "A ParameterValue supplied to this execution."@en ;
    rdfs:domain runtime:SkillExecution ;
    rdfs:range skill:ParameterValue .

runtime:hasStatus a owl:ObjectProperty ;
    rdfs:label "hasStatus"@en ;
    rdfs:comment "The execution status, drawn from the runtime state vocabulary (Executing/Held/Aborted/…)."@en ;
    rdfs:domain runtime:SkillExecution ;
    rdfs:range core:State .

runtime:hasTime a owl:ObjectProperty ;
    rdfs:label "hasTime"@en ;
    rdfs:comment "The time interval over which the execution ran."@en ;
    rdfs:domain runtime:SkillExecution ;
    rdfs:range runtime:TimeInterval .

runtime:invokedVia a owl:ObjectProperty ;
    rdfs:label "invokedVia"@en ;
    rdfs:comment "The communication Endpoint through which the execution was invoked."@en ;
    rdfs:domain runtime:SkillExecution ;
    rdfs:range <https://w3id.org/maestro/communication#Endpoint> .

runtime:mayRaise a owl:ObjectProperty ;
    rdfs:label "mayRaise"@en ;
    rdfs:comment "A fault state (e.g. runtime:Fault) raised during the execution."@en ;
    rdfs:domain runtime:SkillExecution ;
    rdfs:range core:State .

runtime:snapshotTaken a owl:DatatypeProperty ;
    rdfs:label "snapshotTaken"@en ;
    rdfs:comment "Wall-clock timestamp at which the snapshot was captured."@en ;
    rdfs:domain runtime:Snapshot ;
    rdfs:range xsd:dateTime .

runtime:startTime a owl:DatatypeProperty ;
    rdfs:label "startTime"@en ;
    rdfs:domain runtime:TimeInterval ;
    rdfs:range xsd:dateTime .

runtime:timestamp a owl:DatatypeProperty ;
    rdfs:label "timestamp"@en ;
    rdfs:domain runtime:RuntimeEvent ;
    rdfs:range xsd:dateTime .

<https://w3id.org/maestro/sensor> a owl:Ontology ;
    rdfs:label "MAESTRO Sensor Ontology"@en ;
    rdfs:comment "Sensor classes aligned with W3C SSN/SOSA. In 0.3.0 the shadow properties sensor:observes / sensor:hasObservation / sensor:resultValue / sensor:resultTime were removed; use sosa:observes / sosa:madeObservation / sosa:hasSimpleResult / sosa:resultTime directly."@en ;
    owl:versionIRI <https://w3id.org/maestro/sensor/0.4.0> ;
    owl:versionInfo "0.4.0" .

sensor:FeatureOfInterest a owl:Class ;
    rdfs:label "FeatureOfInterest"@en ;
    rdfs:subClassOf sosa:FeatureOfInterest,
        core:LogicalEntity .

sensor:ForceSensor rdfs:label "ForceSensor"@en ;
    rdfs:subClassOf sensor:Sensor .

sensor:ObservableProperty a owl:Class ;
    rdfs:label "ObservableProperty"@en ;
    rdfs:subClassOf sosa:ObservableProperty,
        core:LogicalEntity .

sensor:Observation a owl:Class ;
    rdfs:label "Observation"@en ;
    rdfs:comment "A sensor observation. Subclass of core:Event so it joins the MAESTRO eventing model."@en ;
    rdfs:subClassOf sosa:Observation,
        core:Event .

sensor:PressureSensor rdfs:label "PressureSensor"@en ;
    rdfs:subClassOf sensor:Sensor .

sensor:ProximitySensor rdfs:label "ProximitySensor"@en ;
    rdfs:subClassOf sensor:Sensor .

sensor:TemperatureSensor rdfs:label "TemperatureSensor"@en ;
    rdfs:subClassOf sensor:Sensor .

sensor:TorqueSensor rdfs:label "TorqueSensor"@en ;
    rdfs:subClassOf sensor:Sensor .

sensor:VibrationSensor rdfs:label "VibrationSensor"@en ;
    rdfs:subClassOf sensor:Sensor .

sensor:VisionSensor rdfs:label "VisionSensor"@en ;
    rdfs:comment "Includes industrial cameras and machine-vision systems (replaces res:Camera)."@en ;
    rdfs:subClassOf sensor:Sensor .

sensor:hasObservationEvidence a owl:ObjectProperty ;
    rdfs:label "hasObservationEvidence"@en ;
    rdfs:comment "A Skill is supported by a SOSA Observation as evidence (HHM-Core Skill->Observation obs-evidence edge)."@en ;
    rdfs:domain core:Skill ;
    rdfs:range sosa:Observation .

<https://w3id.org/maestro/skill> a owl:Ontology ;
    rdfs:label "MAESTRO Skill Ontology"@en ;
    rdfs:comment "Keystone of skill-based manufacturing. Skills are logical — they are NOT ROS nodes, PLC FBs, or IEC 61499 FBs. Execution technologies IMPLEMENT skills. 0.4.0 adds reified orchestration (SubSkillLink, ControlFlow, DataBinding), typed parameters (ParameterDef/ParameterValue), Precondition/Effect classes and a protocol-neutral SkillInterface/SkillService — closing the HHM-Core skill-orchestration gap (Priority 1)."@en ;
    owl:versionIRI <https://w3id.org/maestro/skill/0.4.0> ;
    owl:versionInfo "0.4.0" .

skill:Alternative a owl:Class ;
    rdfs:label "Alternative"@en ;
    rdfs:comment "Exclusive choice (alt / branch)."@en ;
    rdfs:subClassOf skill:ControlFlow .

skill:AssemblySkill a owl:Class ;
    rdfs:label "AssemblySkill"@en ;
    rdfs:subClassOf skill:CompositeSkill .

skill:CoordinationSkill a owl:Class ;
    rdfs:label "CoordinationSkill"@en ;
    rdfs:subClassOf skill:CompositeSkill .

skill:HandlingSkill a owl:Class ;
    rdfs:label "HandlingSkill"@en ;
    rdfs:comment "VDI 2860 handling skills (orient, position, deposit, secure)."@en ;
    rdfs:subClassOf skill:AtomicSkill .

skill:InspectionSkill a owl:Class ;
    rdfs:label "InspectionSkill"@en ;
    rdfs:subClassOf skill:AtomicSkill .

skill:Loop a owl:Class ;
    rdfs:label "Loop"@en ;
    rdfs:subClassOf skill:ControlFlow .

skill:ManipulationSkill a owl:Class ;
    rdfs:label "ManipulationSkill"@en ;
    rdfs:comment "Skills that change the spatial relation between a resource and a workpiece (grasp, pick, place, release)."@en ;
    rdfs:subClassOf skill:AtomicSkill .

skill:MotionSkill a owl:Class ;
    rdfs:label "MotionSkill"@en ;
    rdfs:comment "Skills that produce kinematic motion (move linear, move joint, …)."@en ;
    rdfs:subClassOf skill:AtomicSkill .

skill:Optional a owl:Class ;
    rdfs:label "Optional"@en ;
    rdfs:subClassOf skill:ControlFlow .

skill:Parallel a owl:Class ;
    rdfs:label "Parallel"@en ;
    rdfs:subClassOf skill:ControlFlow .

skill:Postcondition a owl:Class ;
    rdfs:label "Postcondition"@en ;
    rdfs:comment "Alias of skill:Effect using the HHM-Core name 'Postcondition'. The reified postcondition target of skill:hasPostcondition."@en ;
    rdfs:subClassOf core:LogicalEntity ;
    owl:equivalentClass skill:Effect .

skill:Precondition a owl:Class ;
    rdfs:label "Precondition"@en ;
    rdfs:comment "A condition that must hold before a Skill runs, expressed over core:State via skill:refersToState. The plain skill:hasPrecondition (Skill→State) shortcut is retained."@en ;
    rdfs:subClassOf core:LogicalEntity .

skill:ProcessSkill a owl:Class ;
    rdfs:label "ProcessSkill"@en ;
    rdfs:subClassOf skill:CompositeSkill .

skill:Sequence a owl:Class ;
    rdfs:label "Sequence"@en ;
    rdfs:subClassOf skill:ControlFlow .

skill:TransferSkill a owl:Class ;
    rdfs:label "TransferSkill"@en ;
    rdfs:comment "A composite skill: pick at A, move to B, place at B."@en ;
    rdfs:subClassOf skill:CompositeSkill .

skill:WeldingSkill a owl:Class ;
    rdfs:label "WeldingSkill"@en ;
    rdfs:subClassOf skill:CompositeSkill .

skill:bindsFrom a owl:ObjectProperty ;
    rdfs:label "bindsFrom"@en ;
    rdfs:comment "Source (producing) parameter of a DataBinding."@en ;
    rdfs:domain skill:DataBinding ;
    rdfs:range skill:ParameterDef .

skill:bindsTo a owl:ObjectProperty ;
    rdfs:label "bindsTo"@en ;
    rdfs:comment "Target (consuming) parameter of a DataBinding."@en ;
    rdfs:domain skill:DataBinding ;
    rdfs:range skill:ParameterDef .

skill:expectedDurationSeconds a owl:DatatypeProperty ;
    rdfs:label "expectedDurationSeconds"@en ;
    rdfs:domain core:Skill ;
    rdfs:range xsd:float .

skill:exposesInterface a owl:ObjectProperty ;
    rdfs:label "exposesInterface"@en ;
    rdfs:comment "A SkillService exposes a SkillInterface."@en ;
    rdfs:domain skill:SkillService ;
    rdfs:range skill:SkillInterface .

skill:hasControlFlow a owl:ObjectProperty ;
    rdfs:label "hasControlFlow"@en ;
    rdfs:comment "Control-flow operator governing a SubSkillLink or a recipe:PlanStep. Domain kept general (core:LogicalEntity) so RDFS domain inference does not conflate PlanSteps with SubSkillLinks."@en ;
    rdfs:domain core:LogicalEntity ;
    rdfs:range skill:ControlFlow .

skill:hasDataBinding a owl:ObjectProperty ;
    rdfs:label "hasDataBinding"@en ;
    rdfs:comment "Attaches a DataBinding to a SubSkillLink or recipe:PlanStep."@en ;
    rdfs:domain core:LogicalEntity ;
    rdfs:range skill:DataBinding .

skill:hasInterfaceContract a owl:ObjectProperty ;
    rdfs:label "hasInterfaceContract"@en ;
    rdfs:comment "A Skill exposes a protocol-neutral SkillInterface contract."@en ;
    rdfs:domain core:Skill ;
    rdfs:range skill:SkillInterface .

skill:hasParameter a owl:ObjectProperty ;
    rdfs:label "hasParameter"@en ;
    rdfs:domain core:Skill .

skill:hasParameterDef a owl:ObjectProperty ;
    rdfs:label "hasParameterDef"@en ;
    rdfs:comment "A Skill declares a typed ParameterDef. Typed successor of skill:hasParameter."@en ;
    rdfs:domain core:Skill ;
    rdfs:range skill:ParameterDef .

skill:hasSubSkillLink a owl:ObjectProperty ;
    rdfs:label "hasSubSkillLink"@en ;
    rdfs:comment "A CompositeSkill carries reified SubSkillLinks to its constituents."@en ;
    rdfs:domain skill:CompositeSkill ;
    rdfs:range skill:SubSkillLink .

skill:instanceOf a owl:ObjectProperty ;
    rdfs:label "instanceOf"@en ;
    rdfs:comment "Links a ParameterValue to the ParameterDef it instantiates."@en ;
    rdfs:domain skill:ParameterValue ;
    rdfs:range skill:ParameterDef .

skill:linksTo a owl:ObjectProperty ;
    rdfs:label "linksTo"@en ;
    rdfs:comment "The constituent Skill referenced by a SubSkillLink."@en ;
    rdfs:domain skill:SubSkillLink ;
    rdfs:range core:Skill .

skill:maxValue a owl:DatatypeProperty ;
    rdfs:label "maxValue"@en ;
    rdfs:domain skill:ParameterDef ;
    rdfs:range xsd:double .

skill:minValue a owl:DatatypeProperty ;
    rdfs:label "minValue"@en ;
    rdfs:domain skill:ParameterDef ;
    rdfs:range xsd:double .

skill:paramType a owl:DatatypeProperty ;
    rdfs:label "paramType"@en ;
    rdfs:comment "Data type of the parameter, given as an XSD datatype IRI (e.g. xsd:double)."@en ;
    rdfs:domain skill:ParameterDef ;
    rdfs:range xsd:anyURI .

skill:refersToState a owl:ObjectProperty ;
    rdfs:label "refersToState"@en ;
    rdfs:comment "Links a Precondition or Effect to the core:State it constrains/produces."@en ;
    rdfs:domain core:LogicalEntity ;
    rdfs:range core:State .

skill:requiresCapability a owl:ObjectProperty ;
    rdfs:label "requiresCapability"@en ;
    rdfs:comment "A Skill requires a Capability (HHM-Core Skill requiresCapability Capability). NOT a sub-property of the Process-level core:requiresCapability: that property's domain is core:Process, which is owl:disjointWith core:Skill, so sub-propertying would make a Skill an illegal Skill∩Process."@en ;
    rdfs:domain core:Skill ;
    rdfs:range core:Capability .

skill:requiresMotion a owl:ObjectProperty ;
    rdfs:label "requiresMotion"@en ;
    rdfs:comment "A Skill requires a reusable technology-neutral Motion specification."@en ;
    rdfs:domain core:Skill ;
    rdfs:range motion:Motion ;
    rdfs:subPropertyOf core:requiresMotion .

skill:unitRef a owl:ObjectProperty ;
    rdfs:label "unitRef"@en ;
    rdfs:comment "QUDT-aligned unit of the parameter, via unit:Unit."@en ;
    rdfs:domain skill:ParameterDef ;
    rdfs:range unit:Unit .

skill:value a owl:DatatypeProperty ;
    rdfs:label "value"@en ;
    rdfs:comment "The supplied literal value of a ParameterValue."@en ;
    rdfs:domain skill:ParameterValue .

<https://w3id.org/maestro/unit> a owl:Ontology ;
    rdfs:label "MAESTRO Unit Ontology"@en ;
    rdfs:comment "Physical units aligned with QUDT."@en ;
    owl:versionIRI <https://w3id.org/maestro/unit/0.3.0> ;
    owl:versionInfo "0.3.0" .

unit:Degree a unit:Unit ;
    rdfs:label "degree"@en ;
    owl:sameAs <http://qudt.org/vocab/unit/DEG> ;
    unit:symbol "°" .

unit:DegreeCelsius a unit:Unit ;
    rdfs:label "degree Celsius"@en ;
    owl:sameAs <http://qudt.org/vocab/unit/DEG_C> ;
    unit:symbol "°C" .

unit:Joule a unit:Unit ;
    rdfs:label "joule"@en ;
    owl:sameAs <http://qudt.org/vocab/unit/J> ;
    unit:symbol "J" .

unit:Kelvin a unit:Unit ;
    rdfs:label "kelvin"@en ;
    owl:sameAs <http://qudt.org/vocab/unit/K> ;
    unit:symbol "K" .

unit:Kilogram a unit:Unit ;
    rdfs:label "kilogram"@en ;
    owl:sameAs <http://qudt.org/vocab/unit/KiloGM> ;
    unit:symbol "kg" .

unit:Metre a unit:Unit ;
    rdfs:label "metre"@en ;
    owl:sameAs <http://qudt.org/vocab/unit/M> ;
    unit:symbol "m" .

unit:MetrePerSecond a unit:Unit ;
    rdfs:label "metre per second"@en ;
    owl:sameAs <http://qudt.org/vocab/unit/M-PER-SEC> ;
    unit:symbol "m/s" .

unit:Millimetre a unit:Unit ;
    rdfs:label "millimetre"@en ;
    owl:sameAs <http://qudt.org/vocab/unit/MilliM> ;
    unit:symbol "mm" .

unit:Newton a unit:Unit ;
    rdfs:label "newton"@en ;
    owl:sameAs <http://qudt.org/vocab/unit/N> ;
    unit:symbol "N" .

unit:Pascal a unit:Unit ;
    rdfs:label "pascal"@en ;
    owl:sameAs <http://qudt.org/vocab/unit/PA> ;
    unit:symbol "Pa" .

unit:Radian a unit:Unit ;
    rdfs:label "radian"@en ;
    owl:sameAs <http://qudt.org/vocab/unit/RAD> ;
    unit:symbol "rad" .

unit:Second a unit:Unit ;
    rdfs:label "second"@en ;
    owl:sameAs <http://qudt.org/vocab/unit/SEC> ;
    unit:symbol "s" .

unit:Watt a unit:Unit ;
    rdfs:label "watt"@en ;
    owl:sameAs <http://qudt.org/vocab/unit/W> ;
    unit:symbol "W" .

unit:hasUnit a owl:ObjectProperty ;
    rdfs:label "hasUnit"@en ;
    rdfs:range unit:Unit .

unit:numericValue a owl:DatatypeProperty ;
    rdfs:label "numericValue"@en ;
    rdfs:range xsd:double .

unit:symbol a owl:DatatypeProperty ;
    rdfs:label "symbol"@en ;
    rdfs:domain unit:Unit ;
    rdfs:range xsd:string .

cap:HandlingCapability a skos:Concept,
        core:Capability ;
    rdfs:label "HandlingCapability"@en ;
    skos:inScheme cap:CapabilityScheme ;
    skos:prefLabel "Handling capability"@en .

core:Constraint a owl:Class ;
    rdfs:label "Constraint"@en ;
    rdfs:comment "A restriction on Skills, Resources, or Processes."@en ;
    rdfs:subClassOf core:LogicalEntity .

core:composedOfSkill a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "composedOfSkill"@en ;
    rdfs:comment "A composite Skill is composed of another Skill. Transitive."@en ;
    rdfs:domain core:Skill ;
    rdfs:range core:Skill .

core:consumes a owl:ObjectProperty ;
    rdfs:label "consumes"@en ;
    rdfs:comment "An Entity consumes an Event."@en ;
    rdfs:domain core:Entity ;
    rdfs:range core:Event .

core:controls a owl:ObjectProperty ;
    rdfs:label "controls"@en ;
    rdfs:comment "A ControlComponent controls a Resource."@en ;
    rdfs:domain core:ControlComponent ;
    rdfs:range core:Resource .

core:emits a owl:ObjectProperty ;
    rdfs:label "emits"@en ;
    rdfs:comment "An Entity emits an Event."@en ;
    rdfs:domain core:Entity ;
    rdfs:range core:Event .

core:hasPart a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "hasPart"@en ;
    rdfs:comment "Mereological part-of relation. Transitive: Plant hasPart Cell, Cell hasPart Robot entails Plant hasPart Robot."@en ;
    rdfs:domain core:Entity ;
    rdfs:range core:Entity ;
    owl:inverseOf core:partOf .

core:hosts a owl:ObjectProperty ;
    rdfs:label "hosts"@en ;
    rdfs:comment "A physical Resource hosts a logical artefact (a ControlComponent, an IEC 61499 RuntimeResource, an OPC UA Server)."@en ;
    rdfs:domain core:Resource ;
    rdfs:range core:LogicalEntity .

core:implementedBy a owl:ObjectProperty ;
    rdfs:label "implementedBy"@en ;
    rdfs:comment "Inverse of core:implements."@en ;
    rdfs:domain core:Skill ;
    rdfs:range core:ControlComponent .

core:partOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "partOf"@en ;
    rdfs:comment "Inverse mereological relation. Transitive."@en ;
    rdfs:domain core:Entity ;
    rdfs:range core:Entity .

core:providedBy a owl:ObjectProperty ;
    rdfs:label "providedBy"@en ;
    rdfs:comment "Inverse of core:provides."@en ;
    rdfs:domain core:Skill ;
    rdfs:range core:Resource .

core:realizedBySkill a owl:ObjectProperty ;
    rdfs:label "realizedBySkill"@en ;
    rdfs:comment "A Capability is realized by a reusable Skill specification."@en ;
    rdfs:domain core:Capability ;
    rdfs:range core:Skill ;
    owl:inverseOf core:realizes .

core:realizes a owl:ObjectProperty ;
    rdfs:label "realizes"@en ;
    rdfs:comment "A Skill realises a Capability."@en ;
    rdfs:domain core:Skill ;
    rdfs:range core:Capability .

core:requiresCapability a owl:ObjectProperty ;
    rdfs:label "requiresCapability"@en ;
    rdfs:comment "A Process requires a Capability."@en ;
    rdfs:domain core:Process ;
    rdfs:range core:Capability .

core:requiresMotion a owl:ObjectProperty ;
    rdfs:label "requiresMotion"@en ;
    rdfs:comment "A Skill requires a technology-neutral motion specification. Range narrowed to motion:Motion in motion.ttl."@en ;
    rdfs:domain core:Skill ;
    rdfs:range core:LogicalEntity .

iec61499:Device a owl:Class ;
    rdfs:label "Device"@en ;
    rdfs:comment "A physical computing device that hosts IEC 61499 RuntimeResources. Subsumed under core:Resource (controller hardware) and aligned with res:ControllerDevice."@en ;
    rdfs:subClassOf core:Resource .

iec61499:RuntimeResource a owl:Class ;
    rdfs:label "RuntimeResource"@en ;
    rdfs:comment "IEC 61499 runtime resource (formerly iec61499:Resource in 0.2.0). Renamed to avoid collision with core:Resource."@en ;
    rdfs:subClassOf core:LogicalEntity .

motion:Axis a owl:Class ;
    rdfs:label "Axis"@en ;
    rdfs:subClassOf core:LogicalEntity .

motion:CoordinateFrame a owl:Class ;
    rdfs:label "CoordinateFrame"@en ;
    rdfs:subClassOf core:LogicalEntity .

motion:LinearMotion a owl:Class ;
    rdfs:label "LinearMotion"@en ;
    rdfs:subClassOf motion:Motion .

opcua:OpcUaMethod a owl:Class ;
    rdfs:label "OpcUaMethod"@en ;
    rdfs:subClassOf opcua:OpcUaNode .

opcua:OpcUaObject a owl:Class ;
    rdfs:label "OpcUaObject"@en ;
    rdfs:subClassOf opcua:OpcUaNode .

opcua:OpcUaServer a owl:Class ;
    rdfs:label "OpcUaServer"@en ;
    rdfs:subClassOf core:ControlComponent .

opcua:exposes a owl:ObjectProperty ;
    rdfs:label "exposes"@en ;
    rdfs:comment "An OPC UA SkillInterface exposes a Skill."@en ;
    rdfs:domain opcua:OpcUaSkillInterface ;
    rdfs:range core:Skill .

proc:HandlingProcess a owl:Class ;
    rdfs:label "HandlingProcess"@en ;
    rdfs:subClassOf proc:ManufacturingProcess .

proc:JoiningProcess a owl:Class ;
    rdfs:label "JoiningProcess"@en ;
    rdfs:comment "DIN 8580 Group 4 — welding, screwing, gluing."@en ;
    rdfs:subClassOf proc:ManufacturingProcess .

proc:Separating a owl:Class ;
    rdfs:label "Separating"@en ;
    rdfs:comment "DIN 8580 Group 3 — cutting, machining."@en ;
    rdfs:subClassOf proc:ManufacturingProcess .

proc:follows a owl:ObjectProperty ;
    rdfs:label "follows"@en ;
    rdfs:domain proc:ManufacturingProcess ;
    rdfs:range proc:ManufacturingProcess .

prod:Assembly a owl:Class ;
    rdfs:label "Assembly"@en ;
    rdfs:comment "A Product composed of multiple Parts and/or sub-Assemblies."@en ;
    rdfs:subClassOf core:Product .

prod:Material a owl:Class ;
    rdfs:label "Material"@en ;
    rdfs:subClassOf core:LogicalEntity .

prod:ProductInstance a owl:Class ;
    rdfs:label "ProductInstance"@en ;
    rdfs:comment "A physically produced unit of a ProductType (what is built). Mirrors HHM-Core ProductInstance."@en ;
    rdfs:subClassOf core:Product .

prod:Requirement a owl:Class ;
    rdfs:label "Requirement"@en ;
    rdfs:comment "A requirement that applies to a product Feature (functional, dimensional, regulatory …)."@en ;
    rdfs:subClassOf core:LogicalEntity .

prod:Tolerance a owl:Class ;
    rdfs:label "Tolerance"@en ;
    rdfs:comment "A dimensional, geometric, or surface tolerance specification."@en ;
    rdfs:subClassOf core:LogicalEntity .

prod:Variant a owl:Class ;
    rdfs:label "Variant"@en ;
    rdfs:comment "A configuration/variant of a ProductType (HHM-Core aligns variants to PRONTO)."@en ;
    rdfs:subClassOf prod:ProductType .

runtime:Busy a skos:Concept,
        core:State ;
    rdfs:label "Busy"@en ;
    rdfs:comment "Resource is currently executing a skill."@en ;
    skos:inScheme runtime:StateScheme ;
    skos:prefLabel "Busy"@en .

skill:Effect a owl:Class ;
    rdfs:label "Effect"@en ;
    rdfs:comment "A postcondition/effect produced by a Skill, expressed over core:State via skill:refersToState. The plain skill:hasPostcondition (Skill→State) shortcut is retained."@en ;
    rdfs:subClassOf core:LogicalEntity .

skill:SkillService a owl:Class ;
    rdfs:label "SkillService"@en ;
    rdfs:comment "A service abstraction (CSS Service) that exposes one or more SkillInterfaces. Mirrors HHM-Core SkillService."@en ;
    rdfs:subClassOf core:LogicalEntity .

skill:composedOfSkill a owl:ObjectProperty ;
    rdfs:label "composedOfSkill"@en ;
    rdfs:comment "A composite Skill has another Skill as a constituent step."@en ;
    rdfs:domain core:Skill ;
    rdfs:range core:Skill ;
    rdfs:subPropertyOf core:composedOfSkill .

skill:hasPostcondition a owl:ObjectProperty ;
    rdfs:label "hasPostcondition"@en ;
    rdfs:comment "A Skill's postcondition/effect. Target is either a core:State (shortcut form) or a reified skill:Postcondition / skill:Effect."@en ;
    rdfs:domain core:Skill ;
    rdfs:range core:LogicalEntity .

skill:hasPrecondition a owl:ObjectProperty ;
    rdfs:label "hasPrecondition"@en ;
    rdfs:comment "A Skill's precondition. Target is either a core:State (shortcut form) or a reified skill:Precondition."@en ;
    rdfs:domain core:Skill ;
    rdfs:range core:LogicalEntity .

core:PhysicalEntity a owl:Class ;
    rdfs:label "PhysicalEntity"@en ;
    rdfs:comment "An entity that has a physical realisation (mass, location)."@en ;
    rdfs:subClassOf core:Entity ;
    owl:disjointWith core:LogicalEntity .

core:Plant a owl:Class ;
    rdfs:label "Plant"@en ;
    rdfs:comment "An aggregation of Resources forming a manufacturing facility."@en ;
    rdfs:subClassOf core:PhysicalEntity .

core:dependsOn a owl:ObjectProperty ;
    rdfs:label "dependsOn"@en ;
    rdfs:comment "Generic dependency relation."@en ;
    rdfs:domain core:Entity ;
    rdfs:range core:Entity .

core:implements a owl:ObjectProperty ;
    rdfs:label "implements"@en ;
    rdfs:comment "A ControlComponent implements a Skill (concrete realisation)."@en ;
    rdfs:domain core:ControlComponent ;
    rdfs:range core:Skill ;
    owl:inverseOf core:implementedBy .

iec61499:CompositeFB a owl:Class ;
    rdfs:label "CompositeFB"@en ;
    rdfs:comment "A composite function block built from interconnected FBs."@en ;
    rdfs:subClassOf iec61499:FunctionBlock .

iec61499:ExecutionEvent a owl:Class ;
    rdfs:label "ExecutionEvent"@en ;
    rdfs:comment "An IEC 61499 execution event (formerly iec61499:Event in 0.2.0). Renamed to avoid collision with core:Event."@en ;
    rdfs:subClassOf core:Event .

res:ControllerDevice a owl:Class ;
    rdfs:label "ControllerDevice"@en ;
    rdfs:comment "Physical controller or compute hardware that hosts logical ControlComponents."@en ;
    rdfs:subClassOf core:Resource .

runtime:RuntimeEvent a owl:Class ;
    rdfs:label "RuntimeEvent"@en ;
    rdfs:subClassOf core:Event .

runtime:Snapshot a owl:Class ;
    rdfs:label "Snapshot"@en ;
    rdfs:comment "Marker class for a runtime snapshot ontology / named graph. New in 0.3.0."@en ;
    rdfs:subClassOf core:LogicalEntity .

runtime:StateTransition a owl:Class ;
    rdfs:label "StateTransition"@en ;
    rdfs:subClassOf runtime:RuntimeEvent .

skill:SubSkillLink a owl:Class ;
    rdfs:label "SubSkillLink"@en ;
    rdfs:comment "A reified composition link from a CompositeSkill to one constituent Skill, so that control-flow (skill:hasControlFlow) and data bindings (skill:hasDataBinding) can be attached per edge. Mirrors HHM-Core SubSkillLink."@en ;
    rdfs:subClassOf core:LogicalEntity .

core:connectedTo a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "connectedTo"@en ;
    rdfs:comment "Physical or logical connectivity between two entities. Symmetric."@en ;
    rdfs:domain core:Entity ;
    rdfs:range core:Entity .

opcua:OpcUaSkillInterface a owl:Class ;
    rdfs:label "OpcUaSkillInterface"@en ;
    rdfs:comment "An OPC UA object that exposes a MAESTRO Skill to network clients. Mirrors the CaSkMan SkillInterface pattern; the OPC UA realisation of the protocol-neutral skill:SkillInterface."@en ;
    rdfs:subClassOf opcua:OpcUaObject,
        skill:SkillInterface .

prod:Feature a owl:Class ;
    rdfs:label "Feature"@en ;
    rdfs:comment "A geometric or functional feature of a Product (hole, slot, surface)."@en ;
    rdfs:subClassOf core:LogicalEntity .

prod:ProductType a owl:Class ;
    rdfs:label "ProductType"@en ;
    rdfs:comment "A product design / catalogue type (what is specified). Mirrors HHM-Core ProductType."@en ;
    rdfs:subClassOf core:Product .

runtime:TimeInterval a owl:Class ;
    rdfs:label "TimeInterval"@en ;
    rdfs:comment "A start/end time interval. Complements the instant-only runtime:timestamp."@en ;
    rdfs:subClassOf core:LogicalEntity .

skill:DataBinding a owl:Class ;
    rdfs:label "DataBinding"@en ;
    rdfs:comment "Binds a producing skill's output parameter to a consuming skill's input parameter. Mirrors HHM-Core DataBinding."@en ;
    rdfs:subClassOf core:LogicalEntity .

skill:ParameterValue a owl:Class ;
    rdfs:label "ParameterValue"@en ;
    rdfs:comment "An instance-level value supplied for a ParameterDef (e.g. at a SkillExecution)."@en ;
    rdfs:subClassOf core:LogicalEntity .

skill:SkillInterface a owl:Class ;
    rdfs:label "SkillInterface"@en ;
    rdfs:comment "A protocol-neutral contract through which a Skill is invoked. Protocol-specific interfaces (OPC UA, REST, DTDL, AAS) are subclasses."@en ;
    rdfs:subClassOf core:LogicalEntity .

core:Process a owl:Class ;
    rdfs:label "Process"@en ;
    rdfs:comment "Manufacturing logic. Requires Capabilities to be executed."@en ;
    rdfs:subClassOf core:LogicalEntity .

res:Robot a owl:Class ;
    rdfs:label "Robot"@en ;
    rdfs:comment "An articulated, programmable, multi-axis machine."@en ;
    rdfs:subClassOf res:Machine .

skill:AtomicSkill a owl:Class ;
    rdfs:label "AtomicSkill"@en ;
    rdfs:comment "An indivisible skill primitive."@en ;
    rdfs:subClassOf core:Skill ;
    owl:disjointWith skill:CompositeSkill .

unit:Quantity a owl:Class ;
    rdfs:label "Quantity"@en ;
    rdfs:subClassOf <http://qudt.org/schema/qudt/Quantity>,
        core:LogicalEntity .

core:Event a owl:Class ;
    rdfs:label "Event"@en ;
    rdfs:comment "A point-in-time occurrence in the manufacturing system."@en ;
    rdfs:subClassOf core:LogicalEntity .

ex:IOSignal a owl:Class ;
    rdfs:label "IOSignal"@en ;
    rdfs:comment "An IEC 61499 datapoint exposed on a skill FB pin. Modelled as a core:State so skills can reference it via standard pre/post-condition properties."@en ;
    rdfs:subClassOf core:State .

opcua:OpcUaNode a owl:Class ;
    rdfs:label "OpcUaNode"@en ;
    rdfs:subClassOf core:LogicalEntity .

prod:BOMNode a owl:Class ;
    rdfs:label "BOMNode"@en ;
    rdfs:comment "A node in a structured bill of materials: a referenced Product with quantity, position and reference designator. Adds structure that prod:Assembly + core:hasPart lack."@en ;
    rdfs:subClassOf core:LogicalEntity .

res:Tool a owl:Class ;
    rdfs:label "Tool"@en ;
    rdfs:subClassOf core:Resource .

skill:ControlFlow a owl:Class ;
    rdfs:label "ControlFlow"@en ;
    rdfs:comment "Branching/looping/optional control between skill steps. Subclasses give the operator; the existing proc:precedes/follows/parallelWith cover the process-level ordering."@en ;
    rdfs:subClassOf core:LogicalEntity .

prod:Identifier a owl:Class ;
    rdfs:label "Identifier"@en ;
    rdfs:comment "A scheme-qualified identifier of a product (GTIN, UUID, IRDI, IRI)."@en ;
    rdfs:subClassOf core:LogicalEntity .

res:Actuator a owl:Class ;
    rdfs:label "Actuator"@en ;
    rdfs:subClassOf core:Resource .

runtime:SkillExecution a owl:Class ;
    rdfs:label "SkillExecution"@en ;
    rdfs:comment "A record of one execution of a Skill on a Resource: its inputs, status, invocation endpoint, faults and time interval. Mirrors HHM-Core SkillExecution; aligned to prov:Activity in execution/prov.ttl."@en ;
    rdfs:subClassOf core:LogicalEntity .

skill:CompositeSkill a owl:Class ;
    rdfs:label "CompositeSkill"@en ;
    rdfs:comment "A skill built by composing other skills via skill:composedOfSkill."@en ;
    rdfs:subClassOf core:Skill .

core:ControlComponent a owl:Class ;
    rdfs:label "ControlComponent"@en ;
    rdfs:comment "A software/hardware element that implements Skills and controls Resources (e.g. ROS node, PLC FB, IEC 61499 FB, OPC UA method)."@en ;
    rdfs:subClassOf core:LogicalEntity .

skill:ParameterDef a owl:Class ;
    rdfs:label "ParameterDef"@en ;
    rdfs:comment "Typed parameter definition of a Skill: a data type, an optional unit reference and an optional numeric range. Replaces the untyped skill:hasParameter target."@en ;
    rdfs:subClassOf core:LogicalEntity .

cap:CapabilityScheme a skos:ConceptScheme ;
    rdfs:label "MAESTRO Capability Scheme"@en ;
    rdfs:comment "SKOS organization for reusable manufacturing capability specifications."@en .

motion:Motion a owl:Class ;
    rdfs:label "Motion"@en ;
    rdfs:comment "A geometric/kinematic movement abstraction."@en ;
    rdfs:subClassOf core:LogicalEntity .

runtime:StateScheme a skos:ConceptScheme ;
    rdfs:label "MAESTRO Runtime State Scheme"@en .

res:Machine a owl:Class ;
    rdfs:label "Machine"@en ;
    rdfs:comment "A general manufacturing machine."@en ;
    rdfs:subClassOf core:Resource .

sensor:Sensor a owl:Class ;
    rdfs:label "Sensor"@en ;
    rdfs:comment "Physical sensor. Subclass of both core:Resource and sosa:Sensor so SOSA-native graphs federate cleanly."@en ;
    rdfs:subClassOf sosa:Sensor,
        core:Resource .

core:Product a owl:Class ;
    rdfs:label "Product"@en ;
    rdfs:comment "A product, part, or assembly that requires manufacturing Processes."@en ;
    rdfs:subClassOf core:LogicalEntity .

iec61499:FunctionBlock a owl:Class ;
    rdfs:label "IEC 61499 FunctionBlock"@en ;
    rdfs:comment "IEC 61499 function block. Disjoint with plc:FunctionBlock (IEC 61131-3 FB) to prevent accidental dual-typing."@en ;
    rdfs:subClassOf core:ControlComponent ;
    owl:disjointWith <https://w3id.org/maestro/iec61131#FunctionBlock> .

core:Entity a owl:Class ;
    rdfs:label "Entity"@en ;
    rdfs:comment "The most general class. Anything modelled in MAESTRO is an Entity."@en .

unit:Unit a owl:Class ;
    rdfs:label "Unit"@en ;
    rdfs:subClassOf <http://qudt.org/schema/qudt/Unit>,
        core:LogicalEntity .

core:State a owl:Class ;
    rdfs:label "State"@en ;
    rdfs:comment "A discrete operational condition of a Resource or ControlComponent."@en ;
    rdfs:subClassOf core:LogicalEntity .

core:Capability a owl:Class ;
    rdfs:label "Capability"@en ;
    rdfs:comment "A manufacturing possibility (what a plant CAN do). Realised by Skills."@en ;
    rdfs:subClassOf core:LogicalEntity ;
    owl:disjointWith core:Process .

proc:ManufacturingProcess a owl:Class ;
    rdfs:label "ManufacturingProcess"@en ;
    rdfs:subClassOf core:Process .

core:Resource a owl:Class ;
    rdfs:label "Resource"@en ;
    rdfs:comment "Any physical manufacturing asset (machine, robot, sensor, actuator, tool)."@en ;
    rdfs:subClassOf core:PhysicalEntity .

core:Skill a owl:Class ;
    rdfs:label "Skill"@en ;
    rdfs:comment "A logical, executable behaviour. Implemented by ControlComponents; provided by Resources."@en ;
    rdfs:subClassOf core:LogicalEntity ;
    owl:disjointWith core:Capability,
        core:Process .

core:LogicalEntity a owl:Class ;
    rdfs:label "LogicalEntity"@en ;
    rdfs:comment "An entity that exists only in the information model."@en ;
    rdfs:subClassOf core:Entity .

#================================================================
# A-BOX  (instances: distribution-station individuals + runtime)
#================================================================

ex:Device_EcoRT_0 a res:PLC ;
    rdfs:label "EcoRT_0 (Soft_dPAC runtime controller)" ;
    core:identifier "device-ecort-0" ;
    iec61499:hostsRuntimeResource ex:Runtime_RES0 ;
    res:manufacturer "Schneider Electric" ;
    res:model "Soft_dPAC" .

ex:DistributingStation1 a core:Plant ;
    rdfs:label "Festo Distributing Station #1" ;
    core:hasPart ex:ControlConsole1,
        ex:FeederUnit1,
        ex:TransferUnit1 ;
    core:hasState runtime:Available ;
    core:identifier "plant-distributing-station-ns4-001" .

ex:FBT_B_MERGE4 a iec61499:BasicFB ;
    rdfs:label "B_MERGE4.fbt" ;
    rdfs:comment "4-input boolean OR merge utility."@en ;
    core:identifier "fbt-B_MERGE4" .

ex:FBT_SkillMagazineController_b_a a iec61499:BasicFB ;
    rdfs:label "SkillMagazineController_b_a.fbt" ;
    rdfs:comment "ECC logic for the magazine. States: INIT, WAIT, stEJECT, stRETRACT, SUCCESS, ERROR, SUSPEND, STOP, TIMEOUT_EJECT, TIMEOUT_RETRACT. PT=4000 ms. Eject precondition: OK_L ∧ OK_R ∧ ¬empty ∧ pos_e."@en ;
    core:identifier "fbt-SkillMagazineController_b_a" ;
    iec61499:controlsResource ex:FeederUnit1 .

ex:FBT_SkillSwivelArm1_Controller_Orchestrator a iec61499:BasicFB ;
    rdfs:label "SkillSwivelArm1_Controller_Orchestrator.fbt" ;
    rdfs:comment "Sequences the 4 elementary operations (STEP1..STEP5) using STATE feedback (=5 means DONE) and LET_L/LET_R permits."@en ;
    core:identifier "fbt-SkillSwivelArm1_Controller_Orchestrator" ;
    ex:permits ex:FBT_skSwivelArm_eo_Grip_workpiece,
        ex:FBT_skSwivelArm_eo_Move_to_downstream,
        ex:FBT_skSwivelArm_eo_Move_to_magazine,
        ex:FBT_skSwivelArm_eo_Release_workpiece ;
    iec61499:controlsResource ex:TransferUnit1 .

ex:FBT_skButtonsLights a iec61499:CompositeFB ;
    rdfs:label "skButtonsLights.fbt" ;
    rdfs:comment "HMI skill. Adapters: ButtonsLights (plug), Perm_L/Perm_R (permits)."@en ;
    core:identifier "fbt-skButtonsLights" ;
    iec61499:controlsResource ex:ControlConsole1 ;
    iec61499:implementsSkill ex:Type_skButtonsLights .

ex:Inst_FB1 a ex:PermitAdapterFB ;
    rdfs:label "FB1 — left true-permit (instance)" ;
    core:identifier "inst-fb1-true-permit" ;
    ex:hostedOn ex:Runtime_RES0 ;
    ex:instanceOfFBT ex:FBT_True_Adp ;
    ex:permits ex:Inst_Magazine .

ex:Inst_FB5 a iec61499:CompositeFB ;
    rdfs:label "FB5 — SwivelArm bus (instance)" ;
    core:identifier "inst-fb5-bus" ;
    ex:hostedOn ex:Runtime_RES0 ;
    ex:instanceOfFBT ex:FBT_SwivelArmBus_4_1 .

ex:Inst_Model a iec61499:CompositeFB ;
    rdfs:label "Model (data-collection instance)" ;
    rdfs:comment "Collects bridged Magazine and Transfer data for monitoring/logging."@en ;
    core:identifier "inst-model" ;
    ex:hostedOn ex:Runtime_RES0 .

ex:OpcUaDistributionInterface a opcua:OpcUaSkillInterface ;
    rdfs:label "OPC UA SkillInterface for the Distributing Station (newsystem4)" ;
    core:identifier "interface-opcua-distribution-ns4-001" ;
    opcua:browseName "DistributingStationSkill" ;
    opcua:exposes ex:Reg_ButtonsLights,
        ex:Reg_Magazine,
        ex:Reg_SwivelArm ;
    opcua:nodeId "ns=2;s=Skill.SwivelArm" .

ex:WorkpieceWP a prod:Part ;
    rdfs:label "Workpiece (Festo cylindrical blank)" ;
    rdfs:comment "Cylindrical MPS workpiece; the through-beam / type sensor reports wp_type ∈ {1,2,3}."@en ;
    prod:massKg 0.030 ;
    prod:requiresProcess ex:DistributeWorkpieceProcess .

ex:CylinderLinearMotion a motion:LinearMotion ;
    rdfs:label "Feeder-cylinder linear motion (80 mm stroke)"@en ;
    rdfs:comment "Linear push/eject of the DSNU-8-80 feeder cylinder separating a workpiece from the magazine (PT=4000 ms timeout budget)."@en ;
    ex:hasDuration [ a unit:Quantity ;
            unit:hasUnit unit:Second ;
            unit:numericValue 4.0 ] ;
    ex:hasStrokeMeters "0.08"^^xsd:float ;
    motion:hasVelocity "0.05"^^xsd:float .

ex:DistributeWorkpieceProcess a proc:TransportProcess ;
    rdfs:label "Distribute workpiece (magazine → downstream station)" ;
    ex:hasSubProcess ex:GripProcess,
        ex:MoveToDownstreamProcess,
        ex:MoveToMagazineProcess,
        ex:PushProcess,
        ex:ReleaseProcess ;
    proc:requiresCapability cap:HandlingCapability,
        cap:PickPlaceCapability,
        cap:TransportCapability .

ex:FBT_Magazine2Magasine a ex:ProtocolAdapterFB ;
    rdfs:label "Magazine2Magasine.fbt" ;
    rdfs:comment "Bridges the internal Magazine adapter to the Magasine protocol: push↔retract, empty, pos_r, pos_e, workpiece-type."@en ;
    core:identifier "fbt-Magazine2Magasine" .

ex:FBT_SwivelArm2Transfer a ex:ProtocolAdapterFB ;
    rdfs:label "SwivelArm2Transfer.fbt" ;
    rdfs:comment "Bridges the internal SwivelArm adapter to the downstream Transfer protocol: at_mgz, at_next, vmon, to_mgz, to_next, vcm_on, vcm_off."@en ;
    core:identifier "fbt-SwivelArm2Transfer" .

ex:FBT_SwivelArmBus_4_1 a iec61499:CompositeFB ;
    rdfs:label "SwivelArmBus_4_1.fbt" ;
    rdfs:comment "Multiplexes the 4 elementary-operation SwivelArm outputs into one, merging to_mgz/to_next/vcm_on/vcm_off via 4× B_MERGE4."@en ;
    core:identifier "fbt-SwivelArmBus_4_1" .

ex:FBT_True_Adp a ex:PermitAdapterFB ;
    rdfs:label "True_Adp.fbt" ;
    rdfs:comment "Always-permit adapter: after E_RESTART + E_DELAY(200 ms) it outputs CNF with OK=TRUE, granting the first skill in the chain permanent permission."@en ;
    core:identifier "fbt-True_Adp" .

ex:FBT_True_Adp_rev a ex:PermitAdapterFB ;
    rdfs:label "True_Adp_rev.fbt" ;
    rdfs:comment "Reversed always-permit adapter terminating the right end of the permit chain (toward the downstream station)."@en ;
    core:identifier "fbt-True_Adp_rev" .

ex:FBT_skMagazine_mo a iec61499:CompositeFB ;
    rdfs:label "skMagazine_mo.fbt" ;
    rdfs:comment "Magazine skill composite. Adapters: Magazine (plug), Perm_L/Perm_R (permit sockets). Internal logic FB: SkillMagazineController_b_a."@en ;
    core:identifier "fbt-skMagazine_mo" ;
    iec61499:controlsResource ex:FeederUnit1 ;
    iec61499:implementsSkill ex:Type_skMagazineEject .

ex:FBT_skSwivelArm_eo_Grip_workpiece a iec61499:CompositeFB ;
    rdfs:label "skSwivelArm_eo_Grip_workpiece.fbt" ;
    rdfs:comment "Elementary operation. Logic: SkillSwivelArm_Grip_workpieceController. Sets vcm_on, waits for vmon."@en ;
    core:identifier "fbt-skSwivelArm_eo_Grip_workpiece" ;
    iec61499:controlsResource ex:VacuumUnit1 ;
    iec61499:implementsSkill ex:Type_skGripWorkpiece .

ex:FBT_skSwivelArm_eo_Move_to_downstream a iec61499:CompositeFB ;
    rdfs:label "skSwivelArm_eo_Move_to_downstream.fbt" ;
    rdfs:comment "Elementary operation. Logic: SkillSwivelArm_Move_to_downstreamController_a."@en ;
    core:identifier "fbt-skSwivelArm_eo_Move_to_downstream" ;
    iec61499:controlsResource ex:TransferMotor1 ;
    iec61499:implementsSkill ex:Type_skMoveToDownstream .

ex:FBT_skSwivelArm_eo_Move_to_magazine a iec61499:CompositeFB ;
    rdfs:label "skSwivelArm_eo_Move_to_magazine.fbt" ;
    rdfs:comment "Elementary operation. Logic: SkillSwivelArm_Move_to_magazineController_b. Blocks if a workpiece is still held."@en ;
    core:identifier "fbt-skSwivelArm_eo_Move_to_magazine" ;
    iec61499:controlsResource ex:TransferMotor1 ;
    iec61499:implementsSkill ex:Type_skMoveToMagazine .

ex:FBT_skSwivelArm_eo_Release_workpiece a iec61499:CompositeFB ;
    rdfs:label "skSwivelArm_eo_Release_workpiece.fbt" ;
    rdfs:comment "Elementary operation. Logic: SkillSwivelArm_Release_workpieceController. Sets vcm_off / blow-off, waits for ¬vmon."@en ;
    core:identifier "fbt-skSwivelArm_eo_Release_workpiece" ;
    iec61499:controlsResource ex:VacuumUnit1 ;
    iec61499:implementsSkill ex:Type_skReleaseWorkpiece .

ex:FBT_skSwivelArm_mo_cmp1 a iec61499:CompositeFB ;
    rdfs:label "skSwivelArm_mo_cmp1.fbt" ;
    rdfs:comment "Transfer-arm skill composite. Contains the 4 elementary-operation FBs, the orchestrator, the bus, and RegisterSkill2. Adapters: Perm_L/Perm_R (permits), Trans (plug → SwivelArm output)."@en ;
    core:identifier "fbt-skSwivelArm_mo_cmp1" ;
    iec61499:controlsResource ex:TransferUnit1 ;
    iec61499:implementsSkill ex:Type_skSwivelArmTransfer .

ex:FeederPusher1 a ex:Pusher ;
    rdfs:label "Feeder pusher" ;
    core:identifier "resource-feeder-pusher-001" ;
    ex:drivenBy ex:FeederCylinder1 .

ex:IO_push a ex:IOSignal ;
    rdfs:label "push"@en ;
    rdfs:comment "Command: drive the feeder cylinder to push / eject a workpiece from the magazine."@en ;
    ex:commandsActuator ex:FeederCylinder1 ;
    ex:ioDirection "output" .

ex:Inst_Conv1 a ex:ProtocolAdapterFB ;
    rdfs:label "Conv1 (instance)" ;
    core:identifier "inst-conv1" ;
    ex:hostedOn ex:Runtime_RES0 ;
    ex:instanceOfFBT ex:FBT_Magazine2Magasine .

ex:Inst_Conv2 a ex:ProtocolAdapterFB ;
    rdfs:label "Conv2 (instance)" ;
    core:identifier "inst-conv2" ;
    ex:hostedOn ex:Runtime_RES0 ;
    ex:instanceOfFBT ex:FBT_SwivelArm2Transfer .

ex:Inst_FB2 a ex:PermitAdapterFB ;
    rdfs:label "FB2 — right true-permit (instance)" ;
    core:identifier "inst-fb2-true-permit" ;
    ex:hostedOn ex:Runtime_RES0 ;
    ex:instanceOfFBT ex:FBT_True_Adp_rev .

ex:Inst_Magazine a iec61499:CompositeFB ;
    rdfs:label "Magazine (instance)" ;
    core:identifier "inst-magazine" ;
    ex:bridges ex:Inst_Conv1 ;
    ex:hostedOn ex:Runtime_RES0 ;
    ex:instanceOfFBT ex:FBT_skMagazine_mo ;
    ex:permits ex:Inst_SwivelArm_Cmp1 .

ex:Inst_SwivelArm_Cmp1 a iec61499:CompositeFB ;
    rdfs:label "SvivelArm_Cmp1 (instance)" ;
    core:identifier "inst-swivelarm-cmp1" ;
    ex:bridges ex:Inst_Conv2 ;
    ex:hostedOn ex:Runtime_RES0 ;
    ex:instanceOfFBT ex:FBT_skSwivelArm_mo_cmp1 ;
    ex:permits ex:Inst_FB2 .

ex:Magazine1 a ex:Magazine ;
    rdfs:label "Magazine (vertical FIFO, 8 workpieces)" ;
    core:hasPart ex:EmptySensor1 ;
    core:hasState runtime:Available ;
    core:identifier "resource-magazine-001" ;
    res:manufacturer "Festo" .

ex:MagazineLoad a sensor:ObservableProperty ;
    rdfs:label "Magazine load (empty/filled)"@en .

ex:PushProcess a proc:HandlingProcess ;
    rdfs:label "Push / eject the bottom workpiece from the magazine" ;
    proc:precedes ex:MoveToMagazineProcess ;
    proc:requiresCapability cap:HandlingCapability .

ex:PusherFrontSensor1 a ex:MagneticProximitySensor ;
    rdfs:label "Pusher front (extended) sensor (SME-8)" ;
    sosa:observes ex:PusherPosition ;
    core:identifier "sensor-pusher-front-001" ;
    ex:createsSignal ex:IO_pos_e ;
    ex:orderNumber "150857" ;
    res:manufacturer "Festo" ;
    res:model "SME-8" .

ex:PusherRearSensor1 a ex:MagneticProximitySensor ;
    rdfs:label "Pusher rear (retracted) sensor (SME-8)" ;
    sosa:observes ex:PusherPosition ;
    core:identifier "sensor-pusher-rear-001" ;
    ex:createsSignal ex:IO_pos_r ;
    ex:orderNumber "150857" ;
    res:manufacturer "Festo" ;
    res:model "SME-8" .

ex:Reg_ButtonsLights a core:Skill ;
    rdfs:label "skButtonsLights" ;
    core:description "Operator HMI: buttons and indicator lamps" ;
    core:partOf ex:App_APP1 ;
    ex:ofType ex:Type_skButtonsLights .

ex:Reg_Magazine a core:Skill ;
    rdfs:label "skMagazine_mo" ;
    core:description "Separates and ejects the bottom workpiece from the stack magazine" ;
    core:partOf ex:App_APP1 ;
    ex:ofType ex:Type_skMagazineEject .

ex:Reg_SwivelArm a core:Skill ;
    rdfs:label "skSwivelArm_mo_cmp1" ;
    core:description "Picks the workpiece at the magazine, rotates 180°, and releases it at the downstream station" ;
    core:partOf ex:App_APP1 ;
    ex:hasSubSkill ex:Reg_SwivelArm_Grip,
        ex:Reg_SwivelArm_MoveToDown,
        ex:Reg_SwivelArm_MoveToMag,
        ex:Reg_SwivelArm_Release ;
    ex:ofType ex:Type_skSwivelArmTransfer .

ex:Reg_SwivelArm_Grip a core:Skill ;
    rdfs:label "Grip_workpiece" ;
    core:partOf ex:App_APP1 ;
    ex:ofType ex:Type_skGripWorkpiece .

ex:Reg_SwivelArm_MoveToDown a core:Skill ;
    rdfs:label "Move_to_downstream" ;
    core:partOf ex:App_APP1 ;
    ex:ofType ex:Type_skMoveToDownstream .

ex:Reg_SwivelArm_MoveToMag a core:Skill ;
    rdfs:label "Move_to_magazine" ;
    core:partOf ex:App_APP1 ;
    ex:ofType ex:Type_skMoveToMagazine .

ex:Reg_SwivelArm_Release a core:Skill ;
    rdfs:label "Release_workpiece" ;
    core:partOf ex:App_APP1 ;
    ex:ofType ex:Type_skReleaseWorkpiece .

ex:SuctionCup1 a ex:SuctionCup ;
    rdfs:label "Suction cup VAS-8" ;
    core:identifier "resource-suction-cup-001" ;
    ex:orderNumber "036135" ;
    res:manufacturer "Festo" ;
    res:model "VAS-8" .

ex:TransferArm1 a res:TransferArm ;
    rdfs:label "Transfer arm (rotary, vacuum-equipped)" ;
    core:hasPart ex:VacuumUnit1 ;
    core:hasState runtime:Available ;
    core:identifier "resource-transfer-arm-001" ;
    ex:drivenBy ex:TransferMotor1 ;
    res:manufacturer "Festo" ;
    res:payload [ a unit:Quantity ;
            unit:hasUnit unit:Kilogram ;
            unit:numericValue 0.1 ] .

ex:TransferArm_LeftSensor1 a ex:LimitSwitch ;
    rdfs:label "Transfer-arm left (at-magazine) micro switch (S-3-E)" ;
    sosa:observes ex:ArmPosition ;
    core:identifier "sensor-arm-left-001" ;
    ex:createsSignal ex:IO_at_mgz ;
    ex:orderNumber "007347" ;
    res:manufacturer "Festo" ;
    res:model "S-3-E" .

ex:TransferArm_RightSensor1 a ex:LimitSwitch ;
    rdfs:label "Transfer-arm right (at-downstream) micro switch (S-3-E)" ;
    sosa:observes ex:ArmPosition ;
    core:identifier "sensor-arm-right-001" ;
    ex:createsSignal ex:IO_at_next ;
    ex:orderNumber "007347" ;
    res:manufacturer "Festo" ;
    res:model "S-3-E" .

ex:VacuumFilter1 a ex:VacuumFilter ;
    rdfs:label "Vacuum filter VAF-8" ;
    core:identifier "resource-vacuum-filter-001" ;
    ex:orderNumber "015889" ;
    res:manufacturer "Festo" ;
    res:model "VAF-8" .

ex:VacuumGenerator1 a ex:VacuumGenerator ;
    rdfs:label "Vacuum generator (~50 l/min @ 6 bar)" ;
    core:identifier "resource-vacuum-generator-001" ;
    ex:orderNumber "185865" ;
    res:manufacturer "Festo" .

ex:VacuumPressure a sensor:ObservableProperty ;
    rdfs:label "Vacuum-line pressure"@en .

ex:VacuumSensor1 a ex:VacuumSwitch ;
    rdfs:label "Vacuum pressure switch (VPEV)" ;
    sosa:observes ex:VacuumPressure ;
    core:identifier "sensor-vacuum-001" ;
    ex:createsSignal ex:IO_vmon ;
    ex:orderNumber "152629" ;
    res:manufacturer "Festo" ;
    res:model "VPEV" .

cap:HandlingCapability cap:realizedBySkill ex:Type_skMagazineEject .

ex:ArmPosition a sensor:ObservableProperty ;
    rdfs:label "Transfer-arm angular position"@en .

ex:ArmRotationalMotion a motion:RotationalMotion ;
    rdfs:label "Transfer-arm rotational motion (180°)"@en ;
    rdfs:comment "Semi-rotary 0–180° motion of the DSR-16-180 transfer motor swinging the arm between magazine and downstream positions (PT=4000 ms timeout budget)."@en ;
    ex:hasDuration [ a unit:Quantity ;
            unit:hasUnit unit:Second ;
            unit:numericValue 4.0 ] ;
    motion:hasVelocity "0.7854"^^xsd:float .

ex:ControlConsole1 a ex:ControlConsole ;
    rdfs:label "Control console (operator HMI)" ;
    core:hasState runtime:Available ;
    core:identifier "resource-control-console-001" ;
    core:provides ex:Type_skButtonsLights ;
    res:manufacturer "Festo" .

ex:EmptySensor1 a ex:ThroughBeamSensor ;
    rdfs:label "Magazine empty / fill-level through-beam sensor (SOEG-L / SOEZ-SE)" ;
    sosa:observes ex:MagazineLoad ;
    core:identifier "sensor-magazine-empty-001" ;
    ex:createsSignal ex:IO_empty ;
    ex:orderNumber "165327" ;
    res:manufacturer "Festo" ;
    res:model "SOEG-L + SOEZ-SE" .

ex:GripProcess a proc:HandlingProcess ;
    rdfs:label "Grip the workpiece with the vacuum suction cup" ;
    proc:precedes ex:MoveToDownstreamProcess ;
    proc:requiresCapability cap:PickPlaceCapability .

ex:IO_empty a ex:IOSignal ;
    rdfs:label "empty"@en ;
    rdfs:comment "TRUE when the magazine is empty (EmptySensor, through-beam SOEG-L)."@en ;
    ex:ioDirection "input" .

ex:IO_pos_e a ex:IOSignal ;
    rdfs:label "pos_e"@en ;
    rdfs:comment "TRUE when the feeder pusher is fully extended (PusherFrontSensor, SME-8)."@en ;
    ex:ioDirection "input" .

ex:IO_pos_r a ex:IOSignal ;
    rdfs:label "pos_r"@en ;
    rdfs:comment "TRUE when the feeder pusher is fully retracted (PusherRearSensor, SME-8)."@en ;
    ex:ioDirection "input" .

ex:IO_to_mgz a ex:IOSignal ;
    rdfs:label "to_mgz"@en ;
    rdfs:comment "Command: rotate the transfer arm toward the magazine."@en ;
    ex:commandsActuator ex:TransferMotor1 ;
    ex:ioDirection "output" .

ex:IO_to_next a ex:IOSignal ;
    rdfs:label "to_next"@en ;
    rdfs:comment "Command: rotate the transfer arm toward the downstream station."@en ;
    ex:commandsActuator ex:TransferMotor1 ;
    ex:ioDirection "output" .

ex:MoveToDownstreamProcess a proc:TransportProcess ;
    rdfs:label "Rotate the swivel arm to the downstream station" ;
    proc:precedes ex:ReleaseProcess ;
    proc:requiresCapability cap:TransportCapability .

ex:MoveToMagazineProcess a proc:TransportProcess ;
    rdfs:label "Rotate the swivel arm to the magazine pickup position" ;
    proc:precedes ex:GripProcess ;
    proc:requiresCapability cap:TransportCapability .

ex:PusherPosition a sensor:ObservableProperty ;
    rdfs:label "Feeder-pusher position"@en .

ex:ReleaseProcess a proc:HandlingProcess ;
    rdfs:label "Release the workpiece at the downstream station" ;
    proc:requiresCapability cap:PickPlaceCapability .

cap:PickPlaceCapability cap:realizedBySkill ex:Type_skSwivelArmTransfer .

cap:TransportCapability cap:realizedBySkill ex:Type_skMoveToDownstream,
        ex:Type_skMoveToMagazine .

ex:FeederCylinder1 a ex:PneumaticCylinder ;
    rdfs:label "Feeder cylinder DSNU-8-80 (double-acting)" ;
    core:identifier "resource-feeder-cylinder-001" ;
    ex:orderNumber "019181" ;
    res:manufacturer "Festo" ;
    res:model "DSNU-8-80" .

ex:FeederUnit1 a ex:FeederUnit ;
    rdfs:label "Feeder unit" ;
    core:hasPart ex:EmptySensor1,
        ex:FeederCylinder1,
        ex:FeederPusher1,
        ex:Magazine1,
        ex:PusherFrontSensor1,
        ex:PusherRearSensor1 ;
    core:hasState runtime:Available ;
    core:identifier "resource-feeder-unit-001" ;
    core:provides ex:Type_skMagazineEject ;
    ex:feeds ex:TransferUnit1 ;
    res:manufacturer "Festo" ;
    res:model "MPS-Distributing-Feeder" .

ex:IO_at_next a ex:IOSignal ;
    rdfs:label "at_next"@en ;
    rdfs:comment "TRUE when the transfer arm is at the downstream-station position (TransferArm_RightSensor, S-3-E)."@en ;
    ex:ioDirection "input" .

ex:IO_vcm_off a ex:IOSignal ;
    rdfs:label "vcm_off"@en ;
    rdfs:comment "Command: close the vacuum valve / blow-off pulse (suction OFF)."@en ;
    ex:commandsActuator ex:VacuumValve1 ;
    ex:ioDirection "output" .

ex:IO_vcm_on a ex:IOSignal ;
    rdfs:label "vcm_on"@en ;
    rdfs:comment "Command: open the vacuum valve (suction ON)."@en ;
    ex:commandsActuator ex:VacuumValve1 ;
    ex:ioDirection "output" .

ex:Type_skButtonsLights a skill:AtomicSkill ;
    rdfs:label "skButtonsLights"@en ;
    rdfs:comment "Operator HMI skill: reads START/STOP/RESET/AUTO-MAN buttons and drives the indicator lamps. Modelled as an atomic primitive (no MAESTRO sub-skills). FBT: skButtonsLights."@en .

ex:VacuumValve1 a ex:VacuumValve ;
    rdfs:label "Vacuum 3/2-way solenoid valve (normally open)" ;
    core:identifier "resource-vacuum-valve-001" ;
    ex:orderNumber "161417" ;
    res:manufacturer "Festo" .

ex:IO_at_mgz a ex:IOSignal ;
    rdfs:label "at_mgz"@en ;
    rdfs:comment "TRUE when the transfer arm is at the magazine position (TransferArm_LeftSensor, S-3-E)."@en ;
    ex:ioDirection "input" .

ex:IO_vmon a ex:IOSignal ;
    rdfs:label "vmon"@en ;
    rdfs:comment "TRUE when the vacuum switch confirms a workpiece is held (VacuumSensor, VPEV)."@en ;
    ex:ioDirection "input" .

ex:TransferUnit1 a ex:TransferUnit ;
    rdfs:label "Transfer unit (swivel arm + vacuum)" ;
    core:hasPart ex:TransferArm1,
        ex:TransferArm_LeftSensor1,
        ex:TransferArm_RightSensor1,
        ex:TransferMotor1,
        ex:VacuumUnit1 ;
    core:hasState runtime:Available ;
    core:identifier "resource-transfer-unit-001" ;
    core:provides ex:Type_skGripWorkpiece,
        ex:Type_skMoveToDownstream,
        ex:Type_skMoveToMagazine,
        ex:Type_skReleaseWorkpiece,
        ex:Type_skSwivelArmTransfer ;
    res:manufacturer "Festo" ;
    res:model "MPS-Distributing-Transfer" .

ex:Type_skMagazineEject a skill:HandlingSkill ;
    rdfs:label "skMagazineEject"@en ;
    rdfs:comment "Separate and eject the bottom workpiece from the magazine. FBT: skMagazine_mo (logic SkillMagazineController_b_a)."@en ;
    ex:controlsIO ex:IO_push ;
    ex:receivesIO ex:IO_empty,
        ex:IO_pos_e,
        ex:IO_pos_r ;
    skill:expectedDurationSeconds 4.0 ;
    skill:requiresMotion ex:CylinderLinearMotion .

ex:Type_skSwivelArmTransfer a skill:TransferSkill ;
    rdfs:label "skSwivelArmTransfer"@en ;
    rdfs:comment "Composite transfer: move to magazine, grip, rotate to downstream, release. Sequenced by SkillSwivelArm1_Controller_Orchestrator. FBT: skSwivelArm_mo_cmp1."@en ;
    ex:controlsIO ex:IO_to_mgz,
        ex:IO_to_next,
        ex:IO_vcm_off,
        ex:IO_vcm_on ;
    ex:hasSubSkill ex:Type_skGripWorkpiece,
        ex:Type_skMoveToDownstream,
        ex:Type_skMoveToMagazine,
        ex:Type_skReleaseWorkpiece ;
    ex:receivesIO ex:IO_at_mgz,
        ex:IO_at_next,
        ex:IO_vmon .

ex:VacuumUnit1 a res:VacuumUnit ;
    rdfs:label "Vacuum unit (end-effector)" ;
    core:hasPart ex:SuctionCup1,
        ex:VacuumFilter1,
        ex:VacuumGenerator1,
        ex:VacuumSensor1,
        ex:VacuumValve1 ;
    core:hasState runtime:Available ;
    core:identifier "resource-vacuum-unit-001" ;
    core:provides ex:Type_skGripWorkpiece,
        ex:Type_skReleaseWorkpiece .

ex:Type_skGripWorkpiece a skill:ManipulationSkill ;
    rdfs:label "skGripWorkpiece"@en ;
    rdfs:comment "Activate vacuum and grip the workpiece. FBT: skSwivelArm_eo_Grip_workpiece."@en ;
    ex:controlsIO ex:IO_vcm_off,
        ex:IO_vcm_on ;
    ex:receivesIO ex:IO_vmon .

ex:Type_skMoveToDownstream a skill:MotionSkill ;
    rdfs:label "skMoveToDownstream"@en ;
    rdfs:comment "Rotate the transfer arm to the downstream-station position. FBT: skSwivelArm_eo_Move_to_downstream."@en ;
    ex:controlsIO ex:IO_to_next ;
    ex:receivesIO ex:IO_at_mgz,
        ex:IO_at_next ;
    skill:expectedDurationSeconds 4.0 ;
    skill:requiresMotion ex:ArmRotationalMotion .

ex:Type_skMoveToMagazine a skill:MotionSkill ;
    rdfs:label "skMoveToMagazine"@en ;
    rdfs:comment "Rotate the transfer arm to the magazine position. FBT: skSwivelArm_eo_Move_to_magazine."@en ;
    ex:controlsIO ex:IO_to_mgz ;
    ex:receivesIO ex:IO_at_mgz ;
    skill:expectedDurationSeconds 4.0 ;
    skill:requiresMotion ex:ArmRotationalMotion .

ex:Type_skReleaseWorkpiece a skill:ManipulationSkill ;
    rdfs:label "skReleaseWorkpiece"@en ;
    rdfs:comment "Release the workpiece (vacuum off + blow-off pulse). FBT: skSwivelArm_eo_Release_workpiece."@en ;
    ex:controlsIO ex:IO_vcm_off,
        ex:IO_vcm_on ;
    ex:receivesIO ex:IO_vmon .

ex:TransferMotor1 a ex:RotaryDrive ;
    rdfs:label "Transfer motor — semi-rotary swivel drive DSR-16-180 (0–180°)" ;
    core:hasState runtime:Available ;
    core:identifier "resource-transfer-motor-001" ;
    ex:orderNumber "011910" ;
    res:manufacturer "Festo" ;
    res:model "DSR-16-180" .

ex:App_APP1 a iec61499:Application ;
    rdfs:label "APP1" ;
    rdfs:comment "Distributing-station application: initialises Magazine then SwivelArm, sequenced by Permit handshaking, with protocol adapters feeding the Model logger."@en ;
    core:identifier "iec61499-app-app1" ;
    ex:hostedOn ex:Runtime_RES0 .

ex:Runtime_RES0 a iec61499:RuntimeResource ;
    rdfs:label "RES0 (EMB_RES_ECO)" ;
    core:identifier "runtime-res0" .
