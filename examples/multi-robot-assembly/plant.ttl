@prefix rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:       <http://www.w3.org/2002/07/owl#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .
@prefix core:      <https://w3id.org/maestro/core#> .
@prefix res:       <https://w3id.org/maestro/resource#> .
@prefix unit:      <https://w3id.org/maestro/unit#> .
@prefix skill:     <https://w3id.org/maestro/skill#> .
@prefix skill-lib: <https://w3id.org/maestro/skill-lib#> .
@prefix cap:       <https://w3id.org/maestro/capability#> .
@prefix proc:      <https://w3id.org/maestro/process#> .
@prefix prod:      <https://w3id.org/maestro/product#> .
@prefix ros:       <https://w3id.org/maestro/ros#> .
@prefix iec61499:  <https://w3id.org/maestro/iec61499#> .
@prefix ex:        <https://w3id.org/maestro/examples/multi-robot-assembly#> .

#################################################################
# EXAMPLE — MULTI-ROBOT ASSEMBLY CELL (DESIGN-TIME)
#
# Plant configuration:
#   - Cobot A (pick + place)
#   - Cobot B (assembly)
#   - Conveyor (transport)
#   - Assembly station
#
# Runtime state (core:hasState) lives in runtime.ttl alongside this file.
# See decisions/0002-runtime-graph-separation.md.
#################################################################

<https://w3id.org/maestro/examples/multi-robot-assembly> a owl:Ontology ;
    owl:versionIRI <https://w3id.org/maestro/examples/multi-robot-assembly/0.3.0> ;
    rdfs:label "MAESTRO Example: Multi-Robot Assembly Cell"@en ;
    owl:imports <https://w3id.org/maestro> ;
    owl:versionInfo "0.3.0" .

#################################################################
# PLANT
#################################################################

ex:Plant2 a core:Plant ;
    rdfs:label "Plant 2 — Multi-Robot Assembly Cell" ;
    core:identifier "plant-assembly-002" ;
    core:hasPart ex:CobotA , ex:CobotB , ex:Conveyor1 , ex:AssemblyStation1 ;
    core:hasPlantCapability cap:PickPlaceCapability ,
                            cap:AssemblyCapability ,
                            cap:TransportCapability .

#################################################################
# RESOURCES
#################################################################

ex:CobotA a res:Cobot ;
    rdfs:label "Cobot A (handler)" ;
    core:identifier "resource-cobot-a" ;
    res:payload [
        a unit:Quantity ;
        unit:numericValue 7.0 ;
        unit:hasUnit unit:Kilogram
    ] ;
    res:reach [
        a unit:Quantity ;
        unit:numericValue 850.0 ;
        unit:hasUnit unit:Millimetre
    ] ;
    core:provides skill-lib:MoveLinear , skill-lib:VacuumPick , skill-lib:Transfer .

ex:CobotB a res:Cobot ;
    rdfs:label "Cobot B (assembler)" ;
    core:identifier "resource-cobot-b" ;
    res:payload [
        a unit:Quantity ;
        unit:numericValue 12.0 ;
        unit:hasUnit unit:Kilogram
    ] ;
    res:reach [
        a unit:Quantity ;
        unit:numericValue 1300.0 ;
        unit:hasUnit unit:Millimetre
    ] ;
    core:provides skill-lib:MoveLinear .

ex:Conveyor1 a res:Conveyor ;
    rdfs:label "Conveyor #1" ;
    core:identifier "resource-conveyor-001" ;
    core:provides skill-lib:MoveLinear .

ex:AssemblyStation1 a res:AssemblyStation ;
    rdfs:label "Assembly Station #1" ;
    core:identifier "resource-assembly-station-001" .
    # No core:provides: triggers shape:ResourceProvidesSkillShape (warning) and
    # is intentionally surfaced by cq04 ("resources without provided skills").

#################################################################
# CONTROL COMPONENTS
#################################################################

ex:CobotANode a ros:ROSNode ;
    rdfs:label "ROS node for Cobot A" ;
    core:identifier "control-cobot-a-node" ;
    ros:rosVersion "iron" ;
    ros:implementsSkill skill-lib:Transfer ;
    ros:controlsResource ex:CobotA .

ex:CobotBNode a ros:ROSNode ;
    rdfs:label "ROS node for Cobot B" ;
    core:identifier "control-cobot-b-node" ;
    ros:rosVersion "iron" ;
    ros:implementsSkill skill-lib:MoveLinear ;
    ros:controlsResource ex:CobotB .

ex:CellCoordinatorFB a iec61499:CompositeFB ;
    rdfs:label "Cell-level IEC 61499 coordinator" ;
    core:identifier "control-cell-coordinator-fb" ;
    iec61499:implementsSkill skill-lib:Transfer ;
    iec61499:controlsResource ex:Conveyor1 .
