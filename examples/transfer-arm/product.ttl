@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix core: <https://w3id.org/maestro/core#> .
@prefix cap:  <https://w3id.org/maestro/capability#> .
@prefix proc: <https://w3id.org/maestro/process#> .
@prefix prod: <https://w3id.org/maestro/product#> .
@prefix ex:   <https://w3id.org/maestro/examples/transfer-arm#> .

#################################################################
# EXAMPLE — PRODUCT REQUIREMENTS
#################################################################

<https://w3id.org/maestro/examples/transfer-arm/product> a owl:Ontology ;
    owl:versionIRI <https://w3id.org/maestro/examples/transfer-arm/product/0.3.0> ;
    rdfs:label "MAESTRO Example: Transfer Arm — Product"@en ;
    owl:imports <https://w3id.org/maestro/examples/transfer-arm> ;
    owl:versionInfo "0.3.0" .

#################################################################
# PROCESSES
#################################################################

ex:PickAndPlaceProcess a proc:HandlingProcess ;
    rdfs:label "Pick and Place Process" ;
    proc:requiresCapability cap:PickPlaceCapability .

#################################################################
# PRODUCT
#################################################################

ex:ProductA a prod:Part ;
    rdfs:label "ProductA — small handled part" ;
    prod:massKg       0.250 ;
    prod:requiresProcess ex:PickAndPlaceProcess .
