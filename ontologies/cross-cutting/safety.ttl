@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix core:   <https://w3id.org/maestro/core#> .
@prefix safety: <https://w3id.org/maestro/safety#> .

#################################################################
# ONTOLOGY DECLARATION
#################################################################

<https://w3id.org/maestro/safety> a owl:Ontology ;
    owl:versionIRI <https://w3id.org/maestro/safety/0.4.0> ;
    rdfs:label "MAESTRO Safety Ontology"@en ;
    owl:imports <https://w3id.org/maestro/core> ;
    owl:versionInfo "0.4.0" ;
    rdfs:comment "Functional safety vocabulary aligned with IEC 61508 and ISO 13849. 0.4.0 adds risk assessment, a safety state, and links from SafetyFunction to the resources/skills it protects, plus a hazard-cause relation that the security module joins to via security:triggersHazard (safety/security convergence)."@en .

#################################################################
# CLASSES
#################################################################

safety:SafetyFunction a owl:Class ;
    rdfs:label "SafetyFunction"@en ;
    rdfs:subClassOf core:LogicalEntity ;
    rdfs:comment "A function intended to maintain or achieve a safe state (IEC 61508)."@en .

safety:Hazard a owl:Class ;
    rdfs:label "Hazard"@en ;
    rdfs:subClassOf core:LogicalEntity .

safety:Risk a owl:Class ;
    rdfs:label "Risk"@en ;
    rdfs:subClassOf core:LogicalEntity .

safety:RiskAssessment a owl:Class ;
    rdfs:label "RiskAssessment"@en ;
    rdfs:subClassOf core:LogicalEntity ;
    rdfs:comment "An assessment that evaluates the Risk associated with a Hazard (ISO 12100 / IEC 61508-1). New in 0.4.0."@en .

safety:SafetyState a owl:Class ;
    rdfs:label "SafetyState"@en ;
    rdfs:subClassOf core:State ;
    rdfs:comment "A discrete safe operational condition a SafetyFunction can drive the system into (e.g. safe-torque-off). New in 0.4.0."@en .

safety:SafetyIntegrityLevel a owl:Class ;
    rdfs:label "SafetyIntegrityLevel"@en ;
    rdfs:comment "IEC 61508 SIL (SIL1 … SIL4)."@en .

safety:SIL1 a safety:SafetyIntegrityLevel ; rdfs:label "SIL 1"@en .
safety:SIL2 a safety:SafetyIntegrityLevel ; rdfs:label "SIL 2"@en .
safety:SIL3 a safety:SafetyIntegrityLevel ; rdfs:label "SIL 3"@en .
safety:SIL4 a safety:SafetyIntegrityLevel ; rdfs:label "SIL 4"@en .

safety:PerformanceLevel a owl:Class ;
    rdfs:label "PerformanceLevel"@en ;
    rdfs:comment "ISO 13849 Performance Level (PL a … PL e)."@en .

safety:PLa a safety:PerformanceLevel ; rdfs:label "PL a"@en .
safety:PLb a safety:PerformanceLevel ; rdfs:label "PL b"@en .
safety:PLc a safety:PerformanceLevel ; rdfs:label "PL c"@en .
safety:PLd a safety:PerformanceLevel ; rdfs:label "PL d"@en .
safety:PLe a safety:PerformanceLevel ; rdfs:label "PL e"@en .

safety:EmergencyStop a owl:Class ;
    rdfs:label "EmergencyStop"@en ;
    rdfs:subClassOf safety:SafetyFunction .

#################################################################
# PROPERTIES
#################################################################

safety:hasSIL a owl:ObjectProperty ;
    rdfs:domain safety:SafetyFunction ;
    rdfs:range  safety:SafetyIntegrityLevel .

safety:hasPerformanceLevel a owl:ObjectProperty ;
    rdfs:domain safety:SafetyFunction ;
    rdfs:range  safety:PerformanceLevel .

safety:mitigates a owl:ObjectProperty ;
    rdfs:domain safety:SafetyFunction ;
    rdfs:range  safety:Hazard .

# --- New in 0.4.0: connect the (previously dangling) SafetyFunction ---

safety:protectsResource a owl:ObjectProperty ;
    rdfs:label "protectsResource"@en ;
    rdfs:domain safety:SafetyFunction ;
    rdfs:range  core:Resource ;
    rdfs:comment "The SafetyFunction protects this Resource. Deliberately NOT a sub-property of core:dependsOn: the dependency runs the other way (the resource/application depends on the safety function), expressed at instance level with core:dependsOn."@en .

safety:assuresSkill a owl:ObjectProperty ;
    rdfs:label "assuresSkill"@en ;
    rdfs:domain safety:SafetyFunction ;
    rdfs:comment "The SafetyFunction assures safe execution of this Skill. Range left open (core:Skill) to avoid importing skill.ttl into core; populated with core:Skill individuals."@en .

safety:hasRiskAssessment a owl:ObjectProperty ;
    rdfs:label "hasRiskAssessment"@en ;
    rdfs:domain safety:Hazard ;
    rdfs:range  safety:RiskAssessment .

safety:assessesRisk a owl:ObjectProperty ;
    rdfs:label "assessesRisk"@en ;
    rdfs:domain safety:RiskAssessment ;
    rdfs:range  safety:Risk .

safety:reachesState a owl:ObjectProperty ;
    rdfs:label "reachesState"@en ;
    rdfs:domain safety:SafetyFunction ;
    rdfs:range  safety:SafetyState .

safety:causedBy a owl:ObjectProperty ;
    rdfs:label "causedBy"@en ;
    rdfs:domain safety:Hazard ;
    rdfs:range  core:Entity ;
    rdfs:comment "The entity (resource, actuator, or — via security:triggersHazard — a cyber threat) whose behaviour can give rise to this Hazard."@en .
