@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix core:   <http://example.org/maestro/core#> .
@prefix safety: <http://example.org/maestro/safety#> .

#################################################################
# ONTOLOGY DECLARATION
#################################################################

<http://example.org/maestro/safety> a owl:Ontology ;
    rdfs:label "MAESTRO Safety Ontology"@en ;
    owl:imports <http://example.org/maestro/core> ;
    owl:versionInfo "0.1.0" ;
    rdfs:comment "Functional safety vocabulary aligned with IEC 61508 and ISO 13849."@en .

#################################################################
# CLASSES
#################################################################

safety:SafetyFunction a owl:Class ;
    rdfs:label "SafetyFunction"@en ;
    rdfs:subClassOf core:LogicalEntity ;
    rdfs:comment "A function intended to maintain or achieve a safe state (IEC 61508)."@en .

safety:Hazard a owl:Class ;
    rdfs:label "Hazard"@en ;
    rdfs:subClassOf core:LogicalEntity .

safety:Risk a owl:Class ;
    rdfs:label "Risk"@en ;
    rdfs:subClassOf core:LogicalEntity .

safety:SafetyIntegrityLevel a owl:Class ;
    rdfs:label "SafetyIntegrityLevel"@en ;
    rdfs:comment "IEC 61508 SIL (SIL1 … SIL4)."@en .

safety:SIL1 a safety:SafetyIntegrityLevel ; rdfs:label "SIL 1"@en .
safety:SIL2 a safety:SafetyIntegrityLevel ; rdfs:label "SIL 2"@en .
safety:SIL3 a safety:SafetyIntegrityLevel ; rdfs:label "SIL 3"@en .
safety:SIL4 a safety:SafetyIntegrityLevel ; rdfs:label "SIL 4"@en .

safety:PerformanceLevel a owl:Class ;
    rdfs:label "PerformanceLevel"@en ;
    rdfs:comment "ISO 13849 Performance Level (PL a … PL e)."@en .

safety:PLa a safety:PerformanceLevel ; rdfs:label "PL a"@en .
safety:PLb a safety:PerformanceLevel ; rdfs:label "PL b"@en .
safety:PLc a safety:PerformanceLevel ; rdfs:label "PL c"@en .
safety:PLd a safety:PerformanceLevel ; rdfs:label "PL d"@en .
safety:PLe a safety:PerformanceLevel ; rdfs:label "PL e"@en .

safety:EmergencyStop a owl:Class ;
    rdfs:label "EmergencyStop"@en ;
    rdfs:subClassOf safety:SafetyFunction .

#################################################################
# PROPERTIES
#################################################################

safety:hasSIL a owl:ObjectProperty ;
    rdfs:domain safety:SafetyFunction ;
    rdfs:range  safety:SafetyIntegrityLevel .

safety:hasPerformanceLevel a owl:ObjectProperty ;
    rdfs:domain safety:SafetyFunction ;
    rdfs:range  safety:PerformanceLevel .

safety:mitigates a owl:ObjectProperty ;
    rdfs:domain safety:SafetyFunction ;
    rdfs:range  safety:Hazard .
